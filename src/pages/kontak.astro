---
import MainLayout from '../layouts/MainLayout.astro';
import Medical3DVector from '../components/Medical3DVector.astro';
---

<MainLayout 
  title="Kontak Kami - KMKI Indonesia"
  description="Kontak resmi Komunitas Medik Katolik Indonesia (KMKI). Jl. Janur Elok 1 QB 7 No.1, Kelapa Gading, Jakarta 14240. Telp. 021-451-5601."
>
  <section class="py-16 bg-gradient-to-br from-sky-900 via-slate-900 to-sky-950 text-white text-center relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <span class="px-3 py-1 rounded-full bg-sky-500/20 text-sky-300 text-xs font-bold uppercase tracking-wider border border-sky-400/30">
        Pusat Komunikasi
      </span>
      <h1 class="text-3xl sm:text-5xl font-black text-white mt-4 tracking-tight">
        Kontak Kami
      </h1>
      <p class="text-base sm:text-lg text-slate-300 max-w-2xl mx-auto mt-3">
        Kami siap melayani kebutuhan informasi keorganisasian, kerja sama ilmiah, kajian bioetika, serta karya bakti medis di 20 keuskupan.
      </p>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
        
        <!-- Left Column: Contact Cards -->
        <div class="lg:col-span-5 space-y-6">
          
          <div class="p-6 rounded-2xl bg-sky-50/70 border border-sky-200">
            <div class="flex items-center gap-4">
              <div class="w-12 h-12 rounded-xl bg-sky-600 text-white flex items-center justify-center shrink-0">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              </div>
              <div>
                <span class="text-xs text-slate-500 block">Telepon Kantor KMKI</span>
                <strong class="text-lg text-slate-900 block font-mono">Telp. 021-451-5601</strong>
                <a href="tel:0214515601" class="text-xs text-sky-700 font-bold hover:underline">
                  Hubungi via Telepon &rarr;
                </a>
              </div>
            </div>
          </div>

          <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200">
            <div class="flex items-center gap-4">
              <div class="w-12 h-12 rounded-xl bg-sky-700 text-white flex items-center justify-center shrink-0">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              </div>
              <div>
                <span class="text-xs text-slate-500 block">Email Resmi Sekretariat</span>
                <strong class="text-sm text-slate-900 block">sekretariat@kmki.or.id</strong>
                <a href="mailto:sekretariat@kmki.or.id" class="text-xs text-sky-700 font-bold hover:underline">
                  Kirim Email Resmi &rarr;
                </a>
              </div>
            </div>
          </div>

          <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200">
            <div class="flex items-center gap-4">
              <div class="w-12 h-12 rounded-xl bg-slate-800 text-white flex items-center justify-center shrink-0">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              </div>
              <div>
                <span class="text-xs text-slate-500 block">Alamat Sekretariat KMKI</span>
                <strong class="text-sm text-slate-900 block">Komunitas Medik Katolik Indonesia</strong>
                <span class="text-xs text-slate-600 leading-relaxed block mt-0.5">
                  Jl. Janur Elok 1 QB 7 No.1, Kelapa Gading, Jakarta 14240, Indonesia
                </span>
              </div>
            </div>
          </div>

          <!-- Event Highlight Box -->
          <div class="p-5 rounded-2xl bg-amber-50 border border-amber-300">
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-bold text-amber-800 uppercase block">Hotline Simposium CCPG 2026:</span>
              <span class="text-[10px] bg-amber-200 text-amber-900 font-bold px-2 py-0.5 rounded-full">Khusus Event</span>
            </div>
            <p class="text-xs text-slate-700 mb-2">
              Untuk pendaftaran, informasi SKP Plataran Sehat, dan konfirmasi tiket simposium:
            </p>
            <div class="flex items-center justify-between pt-2 border-t border-amber-200 text-xs">
              <span class="font-medium text-slate-700">WhatsApp Pendaftaran:</span>
              <a href="https://wa.me/message/5DNKURZLG6SWD1" target="_blank" rel="noopener" class="font-mono font-bold text-emerald-700 hover:underline">
                0851-9060-5900
              </a>
            </div>
          </div>

        </div>

        <!-- Right Column: Interactive Contact / Inquiry Form -->
        <div class="lg:col-span-7">
          <div class="glass-panel p-8 rounded-3xl shadow-xl border border-slate-200 bg-white">
            <h3 class="text-2xl font-bold text-slate-900 mb-2">Kirim Pesan ke KMKI</h3>
            <p class="text-sm text-slate-600 mb-6">Silakan isi formulir berikut. Pesan Anda akan langsung diteruskan ke email resmi sekretariat.</p>

            <form id="contact-form" class="space-y-4">
              <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1">Nama Lengkap & Gelar *</label>
                <input type="text" name="nama" required placeholder="dr. Albertus Pratama" class="w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-sky-500 bg-white" />
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label class="block text-xs font-semibold text-slate-700 mb-1">Email *</label>
                  <input type="email" name="email" required placeholder="dokter@gmail.com" class="w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-sky-500 bg-white" />
                </div>
                <div>
                  <label class="block text-xs font-semibold text-slate-700 mb-1">No. WhatsApp / HP *</label>
                  <input type="tel" name="phone" required placeholder="0812-xxxx-xxxx" class="w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-sky-500 bg-white" />
                </div>
              </div>

              <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1">Perihal / Topik *</label>
                <select name="subject" class="w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-sky-500 bg-white">
                  <option>Informasi Umum KMKI Indonesia</option>
                  <option>Informasi Pendaftaran Simposium CCPG 2026</option>
                  <option>Keanggotaan KMKI di 20 Keuskupan</option>
                  <option>Konsultasi Bioetika Medis & Moral Katolik</option>
                  <option>Kerja Sama Bakti Sosial / CME</option>
                  <option>Lainnya</option>
                </select>
              </div>

              <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1">Pesan Anda *</label>
                <textarea name="message" rows="4" required placeholder="Tuliskan pertanyaan atau kebutuhan informasi Anda di sini..." class="w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-sky-500 bg-white"></textarea>
              </div>

              <button type="submit" class="w-full py-3.5 px-6 rounded-xl bg-sky-600 hover:bg-sky-700 text-white font-bold text-sm shadow-md hover:shadow-lg transition flex items-center justify-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                <span>Kirim Pesan ke Email Sekretariat &rarr;</span>
              </button>
            </form>

            <script>
              const cForm = document.getElementById('contact-form');
              if (cForm) {
                cForm.addEventListener('submit', (e) => {
                  e.preventDefault();
                  const data = new FormData(cForm as HTMLFormElement);
                  const subject = `[Kontak Website KMKI] ${data.get('subject')}`;
                  const body = `Nama: ${data.get('nama')}\nEmail: ${data.get('email')}\nHP/WA: ${data.get('phone')}\nTopik: ${data.get('subject')}\n\nPesan:\n${data.get('message')}`;
                  window.location.href = `mailto:sekretariat@kmki.or.id?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
                });
              }
            </script>
          </div>
        </div>

      </div>

    </div>
  </section>
</MainLayout>
