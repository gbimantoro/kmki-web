---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout 
  title="Jaringan 20 Wilayah Keuskupan - KMKI Indonesia"
  description="Daftar lengkap 20 wilayah keuskupan Komunitas Medik Katolik Indonesia (KMKI) di seluruh nusantara dari Sabang sampai Merauke."
>
  <section class="py-16 bg-gradient-to-br from-sky-900 via-slate-900 to-sky-950 text-white text-center relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <span class="px-3 py-1 rounded-full bg-sky-500/20 text-sky-300 text-xs font-bold uppercase tracking-wider border border-sky-400/30">
        Jejaring Komunitas
      </span>
      <h1 class="text-3xl sm:text-5xl font-black text-white mt-4 tracking-tight">
        20 Wilayah Keuskupan KMKI
      </h1>
      <p class="text-base sm:text-lg text-slate-300 max-w-2xl mx-auto mt-3">
        Menyatukan para profesional medis Katolik di berbagai keuskupan gerejawi di bawah koordinasi Komisi Kesehatan KWI.
      </p>
    </div>
  </section>

  <section class="py-16 bg-slate-50">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Wilayah Regio Pulau Jawa -->
      <div class="mb-12">
        <h2 class="text-xl font-black text-slate-900 mb-6 pb-2 border-b-2 border-sky-600 inline-block">
          Regio Pulau Jawa
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
          
          <div class="p-5 rounded-2xl bg-white border-2 border-amber-400 shadow-sm">
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-bold text-amber-700 bg-amber-100 px-2.5 py-0.5 rounded-full">Host CCPG 2026</span>
              <span class="text-xs text-slate-400 font-mono">KAJ</span>
            </div>
            <h3 class="font-bold text-slate-900 text-base">KMKI Wilayah Keuskupan Agung Jakarta</h3>
            <p class="text-xs text-slate-600 mt-2 leading-relaxed">
              Meliputi DKI Jakarta, Tangerang, dan Bekasi. Berafiliasi dengan RS St. Carolus, RS Atma Jaya, dan pusat pendidikan FKIK Atma Jaya.
            </p>
            <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs">
              <span class="text-slate-500">Info Kontak:</span>
              <a href="/ccpg2026" class="text-amber-600 font-bold hover:underline">Portal CCPG 2026 &rarr;</a>
            </div>
          </div>

          <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-xs">
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-bold text-sky-700 bg-sky-100 px-2.5 py-0.5 rounded-full">Jawa Tengah & DIY</span>
              <span class="text-xs text-slate-400 font-mono">KAS</span>
            </div>
            <h3 class="font-bold text-slate-900 text-base">KMKI Keuskupan Agung Semarang</h3>
            <p class="text-xs text-slate-600 mt-2 leading-relaxed">
              Semarang, Yogyakarta, Surakarta (Solo), Magelang, dan Klaten. Bekerja sama dengan RS Panti Rapih & RS Elisabeth Semarang.
            </p>
          </div>

          <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-xs">
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-bold text-sky-700 bg-sky-100 px-2.5 py-0.5 rounded-full">Jawa Barat</span>
              <span class="text-xs text-slate-400 font-mono">K.Bdg</span>
            </div>
            <h3 class="font-bold text-slate-900 text-base">KMKI Keuskupan Bandung</h3>
            <p class="text-xs text-slate-600 mt-2 leading-relaxed">
              Bandung, Cimahi, Cirebon, Tasikmalaya, dan Garut. Bekerja sama dengan RS Santo Borromeus dan RS Santo Yusup.
            </p>
          </div>

          <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-xs">
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-bold text-sky-700 bg-sky-100 px-2.5 py-0.5 rounded-full">Jawa Barat & Banten</span>
              <span class="text-xs text-slate-400 font-mono">K.Bgr</span>
            </div>
            <h3 class="font-bold text-slate-900 text-base">KMKI Keuskupan Bogor</h3>
            <p class="text-xs text-slate-600 mt-2 leading-relaxed">
              Kota & Kab. Bogor, Depok, Sukabumi, Cianjur, serta Provinsi Banten (Serang, Cilegon, Lebak, Pandeglang).
            </p>
          </div>

          <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-xs">
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-bold text-sky-700 bg-sky-100 px-2.5 py-0.5 rounded-full">Jawa Timur</span>
              <span class="text-xs text-slate-400 font-mono">K.Sby</span>
            </div>
            <h3 class="font-bold text-slate-900 text-base">KMKI Keuskupan Surabaya</h3>
            <p class="text-xs text-slate-600 mt-2 leading-relaxed">
              Surabaya, Sidoarjo, Gresik, Mojokerto, Madiun, Blora. Bekerja sama dengan RS Katolik St. Vincentius a Paulo (RKZ).
            </p>
          </div>

          <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-xs">
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-bold text-sky-700 bg-sky-100 px-2.5 py-0.5 rounded-full">Jawa Timur</span>
              <span class="text-xs text-slate-400 font-mono">K.Mlg</span>
            </div>
            <h3 class="font-bold text-slate-900 text-base">KMKI Keuskupan Malang</h3>
            <p class="text-xs text-slate-600 mt-2 leading-relaxed">
              Malang Raya, Blitar, Pasuruan, Probolinggo, Jember, Banyuwangi. Bekerja sama dengan RS Lavalette & Panti Nirmala.
            </p>
          </div>

        </div>
      </div>

      <!-- Wilayah Luar Jawa -->
      <div>
        <h2 class="text-xl font-black text-slate-900 mb-6 pb-2 border-b-2 border-emerald-600 inline-block">
          Regio Sumatera, Kalimantan, Sulawesi, Nusa Tenggara & Papua
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
          
          <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-xs">
            <span class="text-xs font-bold text-emerald-700 bg-emerald-100 px-2.5 py-0.5 rounded-full">Sumatera Utara</span>
            <h3 class="font-bold text-slate-900 text-base mt-2">KMKI Keuskupan Agung Medan</h3>
            <p class="text-xs text-slate-600 mt-2">Medan, Deli Serdang, Pematangsiantar, Toba, Karo. RS Santa Elisabeth Medan.</p>
          </div>

          <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-xs">
            <span class="text-xs font-bold text-emerald-700 bg-emerald-100 px-2.5 py-0.5 rounded-full">Sumatera Selatan</span>
            <h3 class="font-bold text-slate-900 text-base mt-2">KMKI Keuskupan Agung Palembang</h3>
            <p class="text-xs text-slate-600 mt-2">Palembang, Musi Banyuasin, Lahat, Jambi, Bengkulu. RS Charitas Group Palembang.</p>
          </div>

          <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-xs">
            <span class="text-xs font-bold text-amber-700 bg-amber-100 px-2.5 py-0.5 rounded-full">Kalimantan Barat</span>
            <h3 class="font-bold text-slate-900 text-base mt-2">KMKI Keuskupan Agung Pontianak</h3>
            <p class="text-xs text-slate-600 mt-2">Pontianak, Sanggau, Sekadau, Landak, Mempawah. RS Santo Antonius Pontianak.</p>
          </div>

          <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-xs">
            <span class="text-xs font-bold text-indigo-700 bg-indigo-100 px-2.5 py-0.5 rounded-full">Sulawesi</span>
            <h3 class="font-bold text-slate-900 text-base mt-2">KMKI Keuskupan Agung Makassar</h3>
            <p class="text-xs text-slate-600 mt-2">Makassar, Toraja, Luwu, Mamuju, Kendari. RS Stella Maris Makassar.</p>
          </div>

          <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-xs">
            <span class="text-xs font-bold text-indigo-700 bg-indigo-100 px-2.5 py-0.5 rounded-full">Sulawesi Utara</span>
            <h3 class="font-bold text-slate-900 text-base mt-2">KMKI Keuskupan Manado</h3>
            <p class="text-xs text-slate-600 mt-2">Manado, Minahasa, Tomohon, Bitung, Gorontalo, Sangihe Talaud. RS Gunung Maria.</p>
          </div>

          <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-xs">
            <span class="text-xs font-bold text-rose-700 bg-rose-100 px-2.5 py-0.5 rounded-full">Tanah Papua</span>
            <h3 class="font-bold text-slate-900 text-base mt-2">KMKI Keuskupan Jayapura & Merauke</h3>
            <p class="text-xs text-slate-600 mt-2">Jayapura, Wamena, Timika, Merauke, Asmat, Sorong. Pelayanan medis pedalaman dan stasi.</p>
          </div>

        </div>
      </div>

    </div>
  </section>
</MainLayout>
