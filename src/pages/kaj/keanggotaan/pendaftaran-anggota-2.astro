---
import KAJLayout from '../../../layouts/KAJLayout.astro';
import KAJMembershipForm from '../../../components/KAJMembershipForm.astro';
---

<KAJLayout 
  title="Pendaftaran Anggota KMKI KAJ - Komunitas Medik Katolik Indonesia Keuskupan Agung Jakarta"
  description="Formulir resmi pendaftaran anggota baru Komunitas Medik Katolik Indonesia (KMKI) Wilayah Keuskupan Agung Jakarta. Syarat, langkah pendaftaran, dan keuntungan menjadi anggota."
>

  <!-- Breadcrumb & Header -->
  <section class="pt-8 pb-12 bg-gradient-to-b from-sky-50 via-white to-slate-50 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs text-slate-500 mb-6">
        <a href="https://kmki.or.id/" class="hover:text-sky-600 transition">KMKI Nasional</a>
        <span>/</span>
        <a href="https://kaj.kmki.or.id/" class="hover:text-sky-600 transition">KMKI Wilayah KAJ</a>
        <span>/</span>
        <span class="text-slate-400">Keanggotaan</span>
        <span>/</span>
        <span class="text-sky-700 font-bold">Pendaftaran Anggota</span>
      </nav>

      <div class="max-w-3xl">
        <span class="px-3.5 py-1 rounded-full bg-sky-100 text-sky-800 text-xs font-bold uppercase tracking-wider border border-sky-200">
          Keanggotaan KMKI KAJ
        </span>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 tracking-tight mt-3 mb-4 font-heading">
          Pendaftaran Anggota KMKI Wilayah KAJ
        </h1>
        <p class="text-sm sm:text-base text-slate-600 leading-relaxed">
          Selamat datang rekan sejawat tenaga medis Katolik di wilayah Keuskupan Agung Jakarta. Bergabunglah bersama paguyuban profesi yang menegakkan nilai-nilai moral Kristiani, etika kedokteran, bioetika, serta keunggulan pelayanan klinis.
        </p>
      </div>

    </div>
  </section>

  <!-- Main Content: Form & Details -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <KAJMembershipForm />
    </div>
  </section>

</KAJLayout>
