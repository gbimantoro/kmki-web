---
import EventLayout from '../layouts/EventLayout.astro';
import CCPGNavbar from '../components/CCPGNavbar.astro';
import CCPGSchedule from '../components/CCPGSchedule.astro';
import CCPGSpeakers from '../components/CCPGSpeakers.astro';
import CCPGRegistrationModal from '../components/CCPGRegistrationModal.astro';
import Medical3DVector from '../components/Medical3DVector.astro';
---

<EventLayout
  title="9th CCPG 2026 - Current Clinical Practice Guidelines | Simposium Offline RS Carolus"
  description="Simposium Ilmiah Nasional Offline 9th Current Clinical Practice Guidelines (CCPG) 2026. 7-8 November 2026 di Auditorium Stella Maris RS Carolus. Penguatan Kompetensi Klinis: EBM, Precision Medicine & AI. Akreditasi B Kemenkes RI."
>

  <CCPGNavbar />

  <!-- HERO SECTION: High-Tech Vibrant Medical & Catholic Event -->
  <section class="relative pt-12 pb-20 md:pt-16 md:pb-28 overflow-hidden bg-gradient-to-b from-slate-950 via-slate-900 to-slate-950">
    <!-- Glowing 3D Vector Ambient Lights -->
    <div class="vibrant-glow-blue w-[500px] h-[500px] -top-24 -left-20 opacity-40"></div>
    <div class="vibrant-glow-amber w-[550px] h-[550px] top-20 -right-20 opacity-35"></div>
    <div class="vibrant-glow-emerald w-96 h-96 bottom-0 left-1/3 opacity-25"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      
      <!-- Partner Logo Strip & Accreditation Badge -->
      <div class="flex flex-wrap items-center justify-between gap-4 pb-8 mb-8 border-b border-slate-800/80">
        <!-- Logos -->
        <div class="flex items-center gap-3 sm:gap-5 flex-wrap">
          <img 
            src="/images/assets_extracted/clean/logo-kemenkes.png" 
            alt="Logo Kemenkes RI" 
            class="h-9 sm:h-11 w-auto object-contain bg-white px-2 py-1 rounded-lg shadow-sm"
          />
          <img 
            src="/images/assets_extracted/clean/logo-badiklat.png" 
            alt="Badiklat FKIK Atma Jaya" 
            class="h-9 sm:h-11 w-auto object-contain bg-white px-2 py-1 rounded-lg shadow-sm"
          />
          <img 
            src="/images/assets_extracted/clean/logo-kmki-kaj.png" 
            alt="KMKI Wilayah KAJ" 
            class="h-9 sm:h-11 w-auto object-contain bg-white px-2 py-1 rounded-lg shadow-sm"
          />
          <span class="text-xs text-slate-400 font-medium hidden md:inline">
            RS St. Carolus • Jakarta
          </span>
        </div>

        <!-- Akreditasi B Badge (from PDF) -->
        <div class="flex items-center gap-3 bg-gradient-to-r from-slate-800 to-slate-800/80 px-4 py-2 rounded-2xl border border-amber-400/40 shadow-lg">
          <div class="w-8 h-8 rounded-full bg-amber-400/20 flex items-center justify-center text-amber-400 font-black text-sm">
            B
          </div>
          <div class="text-left">
            <span class="text-[10px] text-amber-300 uppercase tracking-widest font-black block">AKREDITASI B KEMENKES</span>
            <span class="text-xs text-slate-300 font-mono">NOMOR : HK.02.02/F/3956/2024</span>
          </div>
        </div>
      </div>

      <!-- Main Event Hero Content -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <!-- Left: Text & Badges -->
        <div class="lg:col-span-7 space-y-6">
          
          <div class="flex flex-wrap items-center gap-2">
            <span class="px-3.5 py-1 rounded-full text-xs font-black bg-lime-400 text-slate-950 uppercase tracking-wider">
              Offline Symposium
            </span>
            <span class="px-3.5 py-1 rounded-full text-xs font-bold bg-sky-500/20 text-sky-300 border border-sky-400/30">
              Auditorium Stella Maris RS Carolus
            </span>
            <span class="px-3.5 py-1 rounded-full text-xs font-bold bg-amber-400/20 text-amber-300 border border-amber-400/30">
              7-8 November 2026
            </span>
          </div>

          <div>
            <div class="text-amber-400 font-black text-lg sm:text-xl tracking-wide uppercase font-heading">
              9TH SYMPOSIUM
            </div>
            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-white tracking-tight leading-[1.1] font-heading mt-1">
              CURRENT CLINICAL PRACTICE GUIDELINES
            </h1>
            <div class="text-2xl sm:text-3xl font-black text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-orange-400 to-amber-300 mt-2 font-mono">
              #CCPG2026
            </div>
          </div>

          <!-- Highlight Theme Box -->
          <div class="p-5 rounded-2xl bg-gradient-to-r from-amber-500/20 via-orange-500/10 to-transparent border-l-4 border-l-amber-400 border border-amber-500/20">
            <span class="text-[11px] text-amber-300 font-bold uppercase tracking-wider block mb-1">Tema Utama Simposium:</span>
            <p class="text-base sm:text-lg text-white font-semibold leading-snug">
              "Penguatan Kompetensi Klinis dalam Praktik Kedokteran melalui Evidence-Based Practice, Precision Medicine, dan Artificial Intelligence"
            </p>
          </div>

          <!-- Institutional Collaboration Statement -->
          <p class="text-xs sm:text-sm text-slate-400 leading-relaxed">
            Diselenggarakan oleh <strong class="text-slate-200">Badan Pendidikan dan Pelatihan FKIK Universitas Katolik Indonesia Atma Jaya</strong> bekerja sama dengan <strong class="text-slate-200">Panitia Current Clinical Practice Guidelines (CCPG) 2026 - Komunitas Medis Katolik Indonesia Keuskupan Agung Jakarta (KMKI-KAJ)</strong>.
          </p>

          <!-- Key Event Metric Pills -->
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 pt-2">
            <div class="p-3.5 rounded-xl bg-slate-800/80 border border-slate-700 text-center">
              <span class="text-2xl font-black text-amber-400 font-mono">2 HARI</span>
              <span class="text-[11px] text-slate-400 block mt-0.5">7-8 Nov (07.00-16.00)</span>
            </div>
            <div class="p-3.5 rounded-xl bg-slate-800/80 border border-slate-700 text-center">
              <span class="text-2xl font-black text-sky-400 font-mono">18+ PAKAR</span>
              <span class="text-[11px] text-slate-400 block mt-0.5">Spesialis & Konsultan</span>
            </div>
            <div class="p-3.5 rounded-xl bg-slate-800/80 border border-slate-700 text-center col-span-2 sm:col-span-1">
              <span class="text-2xl font-black text-emerald-400 font-mono">SKP RESMI</span>
              <span class="text-[11px] text-slate-400 block mt-0.5">Satu Sehat SDMK</span>
            </div>
          </div>

          <!-- Action Buttons -->
          <div class="flex flex-col sm:flex-row items-center gap-4 pt-2">
            <a 
              href="#daftar" 
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 rounded-xl text-base font-black text-slate-950 bg-gradient-to-r from-amber-400 via-amber-500 to-yellow-500 hover:from-amber-300 hover:to-yellow-400 shadow-xl shadow-amber-500/20 hover:shadow-amber-500/30 transition transform hover:-translate-y-0.5"
            >
              <svg class="w-5 h-5 text-slate-950" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
              <span>Daftar Simposium Sekarang</span>
            </a>

            <a 
              href="#jadwal" 
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-4 rounded-xl text-sm font-semibold text-slate-200 bg-slate-800 hover:bg-slate-750 border border-slate-700 transition"
            >
              <span>Lihat Jadwal 7-8 Nov</span>
              <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </a>

            <a 
              href="/images/SYMPOSIUM_KMKI_KAJ_2026.pdf" 
              download 
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 py-4 rounded-xl text-sm font-medium text-slate-400 hover:text-white transition"
              title="Unduh PDF Resmi"
            >
              <svg class="w-4 h-4 text-sky-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
              <span>Unduh Brosur</span>
            </a>
          </div>

        </div>

        <!-- Right: 3D Visual & Flyer Preview -->
        <div class="lg:col-span-5">
          <div class="relative group">
            
            <!-- 3D Floating Badges -->
            <div class="absolute -top-4 -left-4 z-20 hidden sm:block">
              <div class="glass-panel-dark p-3 rounded-2xl shadow-2xl flex items-center gap-3 border border-sky-500/40">
                <Medical3DVector name="stethoscope-ai" size={40} />
                <div>
                  <p class="text-xs font-bold text-white">Clinical AI & EBM</p>
                  <p class="text-[10px] text-sky-300">Decision Making Masa Depan</p>
                </div>
              </div>
            </div>

            <div class="absolute -bottom-4 -right-4 z-20 hidden sm:block">
              <div class="glass-panel-dark p-3 rounded-2xl shadow-2xl flex items-center gap-3 border border-amber-500/40">
                <Medical3DVector name="award-skp" size={40} />
                <div>
                  <p class="text-xs font-bold text-white">Akreditasi B Resmi</p>
                  <p class="text-[10px] text-amber-300">SKP Kemenkes RI</p>
                </div>
              </div>
            </div>

            <!-- Flyer Showcase Image -->
            <div class="rounded-3xl overflow-hidden border-2 border-slate-700 shadow-2xl bg-slate-950 relative">
              <img 
                src="/images/pdf_extracted/page-1.png" 
                alt="Flyer Simposium CCPG 2026" 
                class="w-full h-auto object-cover max-h-[580px] hover:scale-102 transition duration-500"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-transparent to-transparent flex flex-col justify-end p-6">
                <div class="flex items-center justify-between">
                  <div>
                    <span class="text-[10px] text-slate-400 block">Biaya Investasi:</span>
                    <span class="text-sm font-bold text-white">Dokter: Rp 300rb • Spesialis: Rp 400rb</span>
                  </div>
                  <a href="#daftar" class="text-xs font-black text-amber-400 hover:text-amber-300 underline">
                    Daftar Sekarang &rarr;
                  </a>
                </div>
              </div>
            </div>

          </div>
        </div>

      </div>

    </div>
  </section>


  <!-- TEMA & AKREDITASI SECTION -->
  <section id="akreditasi" class="py-16 bg-slate-950 border-y border-slate-800/80 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        
        <!-- Left: Accreditation Explanation -->
        <div class="lg:col-span-8 space-y-4">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-emerald-500/20 text-emerald-300 text-xs font-bold border border-emerald-400/30">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
            <span>Terakreditasi Resmi Kemenkes RI</span>
          </div>

          <h2 class="text-2xl sm:text-3xl font-black text-white font-heading">
            Standar Akreditasi B Kemenkes & Integrasi Satu Sehat
          </h2>

          <p class="text-sm text-slate-300 leading-relaxed">
            Penyelenggaraan 9th CCPG 2026 telah memperoleh <strong>Akreditasi B Kemenkes RI</strong> dengan <strong>Nomor Akreditasi: HK.02.02/F/3956/2024</strong>. Peserta simposium yang hadir penuh secara offline di Auditorium Stella Maris RS Carolus akan mendapatkan Satuan Kredit Profesi (SKP) Kemenkes RI.
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
            <div class="p-4 rounded-xl bg-slate-900 border border-slate-800">
              <span class="text-xs font-bold text-amber-300 block mb-1">Persyaratan Penting Peserta:</span>
              <p class="text-xs text-slate-300 leading-relaxed">
                Setiap peserta wajib memiliki akun aktif di <strong>Satu Sehat SDMK / Plataran Sehat</strong>. Pastikan NIK dan email yang didaftarkan sinkron dengan akun Plataran Sehat Anda.
              </p>
            </div>

            <div class="p-4 rounded-xl bg-slate-900 border border-slate-800">
              <span class="text-xs font-bold text-sky-300 block mb-1">Penyelenggara Terakreditasi:</span>
              <p class="text-xs text-slate-300 leading-relaxed">
                Badiklat FKIK Unika Atma Jaya selaku institusi pelatihan medis terakreditasi menjamin mutu ilmiah, silabus, dan evaluasi hasil pembelajaran klinis simposium.
              </p>
            </div>
          </div>
        </div>

        <!-- Right: Validation QR Box (From PDF) -->
        <div class="lg:col-span-4 flex flex-col items-center justify-center p-6 rounded-3xl bg-slate-900 border border-slate-800 text-center">
          <span class="text-xs font-bold text-amber-300 uppercase tracking-wider block mb-3">Validasi di Sini:</span>
          <img 
            src="/images/assets_extracted/clean/qr-code-1.png" 
            alt="Validasi Sasaran Peserta dan Nilai SKP" 
            class="w-40 h-40 bg-white p-2 rounded-2xl shadow-md border border-slate-700"
          />
          <span class="text-xs font-bold text-white mt-3 block">Sasaran Peserta & Nilai SKP</span>
          <span class="text-[11px] text-slate-400 mt-0.5">Scan QR untuk verifikasi Plataran Sehat</span>
        </div>

      </div>

    </div>
  </section>


  <!-- JADWAL ILMIAH INTERAKTIF SECTION -->
  <section id="jadwal" class="py-20 bg-slate-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-12">
        <span class="px-3.5 py-1 rounded-full bg-amber-400/20 text-amber-300 text-xs font-black uppercase tracking-wider border border-amber-400/30">
          Susunan Acara Lengkap
        </span>
        <h2 class="text-3xl sm:text-4xl font-black text-white mt-3 tracking-tight font-heading">
          Jadwal Simposium Ilmiah 7 - 8 November 2026
        </h2>
        <p class="text-sm text-slate-400 mt-2">
          Dua hari intensif mencakup 3 Plenary Lectures, 7 Sesi Klinis Spesialis, dan 2 Lunch Simposium bersama para pakar terkemuka.
        </p>
      </div>

      <!-- Schedule Component -->
      <CCPGSchedule />

    </div>
  </section>


  <!-- 18+ DAFTAR PEMBICARA SPESIALIS SECTION -->
  <section id="pembicara" class="py-20 bg-slate-950 border-t border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-12">
        <span class="px-3.5 py-1 rounded-full bg-sky-500/20 text-sky-300 text-xs font-bold uppercase tracking-wider border border-sky-400/30">
          Narasumber Terkemuka
        </span>
        <h2 class="text-3xl sm:text-4xl font-black text-white mt-3 tracking-tight font-heading">
          18+ Pakar, Konsultan & Dokter Spesialis
        </h2>
        <p class="text-sm text-slate-400 mt-2">
          Menghadirkan para klinisi senior dan akademisi dari berbagai cabang keilmuan medis untuk membagikan panduan klinis mutakhir.
        </p>
      </div>

      <!-- Speakers Component -->
      <CCPGSpeakers />

    </div>
  </section>


  <!-- BIAYA PENDAFTARAN & REGISTRASI ONLINE SECTION -->
  <section id="biaya" class="py-20 bg-slate-900 border-t border-slate-800 relative">
    <div id="daftar"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-14">
        <span class="px-3.5 py-1 rounded-full bg-amber-400/20 text-amber-300 text-xs font-black uppercase tracking-wider border border-amber-400/30">
          Investasi & Tiket
        </span>
        <h2 class="text-3xl sm:text-4xl font-black text-white mt-3 tracking-tight font-heading">
          Pendaftaran & Biaya Kepesertaan
        </h2>
        <p class="text-sm text-slate-400 mt-2">
          Pendaftaran simposium offline telah dibuka. Tempat terbatas di Auditorium Stella Maris RS Carolus.
        </p>
      </div>

      <!-- Registration Form & Pricing Modal -->
      <CCPGRegistrationModal />

    </div>
  </section>


  <!-- FLYER BROWSER & CANVA ASSETS GALLERY -->
  <section id="galeri-flyer" class="py-20 bg-slate-950 border-t border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-12">
        <span class="px-3.5 py-1 rounded-full bg-sky-500/20 text-sky-300 text-xs font-bold uppercase tracking-wider border border-sky-400/30">
          Materi Publikasi Resmi
        </span>
        <h2 class="text-3xl font-black text-white mt-3 tracking-tight font-heading">
          Flyer & Banner Simposium CCPG 2026
        </h2>
        <p class="text-sm text-slate-400 mt-2">
          Desain resmi berbasis flyer symposium KMKI KAJ 2026 dan template publikasi Canva.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        
        <div class="glass-panel-dark p-4 rounded-2xl border border-slate-800 group">
          <div class="rounded-xl overflow-hidden mb-3 bg-slate-900 border border-slate-700">
            <img 
              src="/images/pdf_extracted/page-1.png" 
              alt="Flyer Halaman 1 - Overview Sesi" 
              class="w-full h-72 object-cover object-top group-hover:scale-105 transition duration-500"
            />
          </div>
          <h4 class="font-bold text-white text-sm">Flyer Lengkap: Silabus & Kontak Panitia</h4>
          <p class="text-[11px] text-slate-400 mt-1">Portrait Flyer resmi CCPG 2026 dengan rincian jadwal hari 1 & 2.</p>
          <a 
            href="/images/pdf_extracted/page-1.png" 
            target="_blank" 
            class="mt-3 inline-flex items-center gap-1 text-xs font-bold text-amber-400 hover:text-amber-300"
          >
            Lihat Resolusi Penuh &rarr;
          </a>
        </div>

        <div class="glass-panel-dark p-4 rounded-2xl border border-slate-800 group">
          <div class="rounded-xl overflow-hidden mb-3 bg-slate-900 border border-slate-700">
            <img 
              src="/images/pdf_extracted/page-2.png" 
              alt="Flyer Halaman 2 - QR Pendaftaran" 
              class="w-full h-72 object-cover object-top group-hover:scale-105 transition duration-500"
            />
          </div>
          <h4 class="font-bold text-white text-sm">Flyer Pendaftaran & QR WhatsApp</h4>
          <p class="text-[11px] text-slate-400 mt-1">Flyer dengan barcode registrasi WhatsApp hotline 0851-9060-5900.</p>
          <a 
            href="/images/pdf_extracted/page-2.png" 
            target="_blank" 
            class="mt-3 inline-flex items-center gap-1 text-xs font-bold text-amber-400 hover:text-amber-300"
          >
            Lihat Resolusi Penuh &rarr;
          </a>
        </div>

        <div class="glass-panel-dark p-4 rounded-2xl border border-slate-800 group">
          <div class="rounded-xl overflow-hidden mb-3 bg-slate-900 border border-slate-700">
            <img 
              src="/images/pdf_extracted/page-3.png" 
              alt="Flyer Widescreen Hari 1" 
              class="w-full h-72 object-cover group-hover:scale-105 transition duration-500"
            />
          </div>
          <h4 class="font-bold text-white text-sm">Banner Widescreen: Hari 1 (7 Nov 2026)</h4>
          <p class="text-[11px] text-slate-400 mt-1">Banner digital rasio 16:9 untuk presentasi dan LED screen panggung.</p>
          <a 
            href="/images/pdf_extracted/page-3.png" 
            target="_blank" 
            class="mt-3 inline-flex items-center gap-1 text-xs font-bold text-amber-400 hover:text-amber-300"
          >
            Lihat Resolusi Penuh &rarr;
          </a>
        </div>

      </div>

    </div>
  </section>


  <!-- LOKASI & VENUE SECTION: RS CAROLUS STELLA MARIS -->
  <section id="lokasi" class="py-20 bg-slate-900 border-t border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        
        <div class="lg:col-span-6 space-y-5">
          <span class="px-3 py-1 rounded-full bg-amber-400/20 text-amber-300 text-xs font-bold uppercase tracking-wider border border-amber-400/30">
            Lokasi Simposium Offline
          </span>
          <h2 class="text-3xl sm:text-4xl font-black text-white font-heading">
            Auditorium Stella Maris, RS Carolus
          </h2>
          <p class="text-sm text-slate-300 leading-relaxed">
            Simposium diselenggarakan secara tatap muka (offline) di auditorium modern <strong>Auditorium Stella Maris</strong>, Kompleks Rumah Sakit St. Carolus, Salemba, Jakarta Pusat.
          </p>

          <div class="space-y-3 text-xs text-slate-300 pt-2">
            <div class="flex items-start gap-3">
              <div class="w-7 h-7 rounded-lg bg-sky-500/20 text-sky-400 flex items-center justify-center shrink-0 mt-0.5">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              </div>
              <div>
                <strong class="text-white block">Alamat Lengkap:</strong>
                <span>Jl. Salemba Raya No. 41, Paseban, Kec. Senen, Kota Jakarta Pusat, DKI Jakarta 10440</span>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <div class="w-7 h-7 rounded-lg bg-emerald-500/20 text-emerald-400 flex items-center justify-center shrink-0 mt-0.5">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
              </div>
              <div>
                <strong class="text-white block">Waktu Registrasi Ulang:</strong>
                <span>Sabtu, 7 November 2026 mulai pukul 07.00 WIB di meja registrasi lantai dasar.</span>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <div class="w-7 h-7 rounded-lg bg-amber-500/20 text-amber-400 flex items-center justify-center shrink-0 mt-0.5">
