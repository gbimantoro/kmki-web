            <!-- Contact Person Card -->
            <div class="p-5 rounded-3xl bg-gradient-to-r from-emerald-950/40 to-slate-900 border border-emerald-500/40 flex items-center justify-between gap-4">
              <div>
                <span class="text-[10px] font-bold text-emerald-400 uppercase tracking-wider block">Info & Konsultasi Abstrak:</span>
                <h4 class="text-sm font-bold text-white mt-0.5">dr. Danny Radja, SpKKLP, B.Math</h4>
                <p class="text-xs text-emerald-300 font-mono mt-0.5">{waContact}</p>
