                class="px-4 py-2 rounded-xl bg-emerald-500 hover:bg-emerald-600 text-white text-xs font-bold shrink-0 shadow-md transition"
              >
                Chat WA &rarr;
              </a>
            </div>

          </div>

        </div>

      </div>
    </section>


    <!-- SECTION 4: TEMPLATE JUDUL & ABSTRAK -->
    <section id="template" class="py-16 bg-slate-950 border-t border-slate-800 relative z-10">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
          <div>
            <span class="text-xs font-black tracking-widest text-amber-400 uppercase block mb-1">
              CONTOH STRUKTUR PENULISAN
            </span>
            <h2 class="text-2xl sm:text-3xl font-black text-white font-heading">
              Template Judul & Abstrak
            </h2>
            <p class="text-xs text-slate-400 mt-1">
              Gunakan panduan format berikut sebagai acuan penulisan di Microsoft Word.
            </p>
          </div>

          <button 
            type="button" 
            id="btn-copy-template"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-amber-400 hover:bg-amber-300 text-slate-950 font-black text-xs transition shadow-md self-start sm:self-auto"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
            <span id="btn-copy-template-text">Salin Seluruh Template</span>
          </button>
        </div>

        <!-- Template Code / Text Block -->
        <div class="rounded-3xl bg-slate-900 border-2 border-slate-800 overflow-hidden shadow-2xl">
          <div class="px-6 py-3 bg-slate-850 border-b border-slate-800 flex items-center justify-between text-xs text-slate-400 font-mono">
            <span class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-red-500/80 inline-block"></span>
              <span class="w-3 h-3 rounded-full bg-yellow-500/80 inline-block"></span>
              <span class="w-3 h-3 rounded-full bg-green-500/80 inline-block"></span>
              <span class="ml-2">template-abstrak-ccpg2026.txt</span>
            </span>
            <span class="text-amber-400 font-sans font-semibold">Maks. 300 Kata</span>
          </div>

          <div class="p-6 sm:p-8 font-mono text-xs sm:text-sm text-slate-200 leading-relaxed overflow-x-auto select-all" id="template-text-block">
<p class="font-bold text-amber-300 text-base mb-2">JUDUL ABSTRAK</p>
<p class="text-slate-300 mb-1">Nama Penulis¹, Nama Penulis²</p>
<p class="text-slate-400 text-xs mb-6">¹Institusi, Kota<br/>²Institusi, Kota</p>

<div class="space-y-4">
  <div>
    <strong class="text-amber-400 block font-sans text-xs uppercase tracking-wider">Background:</strong>
    <p class="text-slate-300">Tuliskan latar belakang dan alasan pentingnya topik yang dibahas.</p>
  </div>

  <div>
    <strong class="text-amber-400 block font-sans text-xs uppercase tracking-wider">Objective:</strong>
    <p class="text-slate-300">Tuliskan tujuan penelitian atau laporan kasus.</p>
  </div>

  <div>
    <strong class="text-amber-400 block font-sans text-xs uppercase tracking-wider">Methods / Case Presentation:</strong>
    <p class="text-slate-300">Tuliskan metode penelitian atau gambaran kasus secara ringkas.</p>
  </div>

  <div>
    <strong class="text-amber-400 block font-sans text-xs uppercase tracking-wider">Results / Discussion:</strong>
    <p class="text-slate-300">Tuliskan hasil utama atau pembahasan klinis yang relevan.</p>
  </div>

  <div>
    <strong class="text-amber-400 block font-sans text-xs uppercase tracking-wider">Conclusion:</strong>
    <p class="text-slate-300">Tuliskan kesimpulan dan implikasi klinis.</p>
  </div>

  <div class="pt-2 border-t border-slate-800">
    <strong class="text-amber-400 block font-sans text-xs uppercase tracking-wider">Keywords:</strong>
    <p class="text-slate-400 italic">Keyword 1; Keyword 2; Keyword 3; Keyword 4; Keyword 5</p>
  </div>
</div>
          </div>

          <div class="px-6 py-4 bg-slate-900 border-t border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-slate-400">
            <span>Pastikan dokumen disimpan dalam format <strong>.docx</strong> atau <strong>.doc</strong> sebelum dikirimkan.</span>
            <a 
              href={mailtoLink}
              class="text-sky-400 hover:text-sky-300 font-bold underline"
            >
              Kirim ke {emailDestination} &rarr;
            </a>
          </div>
        </div>

      </div>
    </section>

  </main>

  <!-- COPY TOAST SCRIPT -->
  <script>
    // Copy Template Functionality
    const copyTemplateBtn = document.getElementById('btn-copy-template');
    const copyTemplateText = document.getElementById('btn-copy-template-text');
    const templateContent = `JUDUL ABSTRAK
Nama Penulis¹, Nama Penulis²
¹Institusi, Kota
²Institusi, Kota

Background:
Tuliskan latar belakang dan alasan pentingnya topik yang dibahas.

Objective:
Tuliskan tujuan penelitian atau laporan kasus.

Methods / Case Presentation:
Tuliskan metode penelitian atau gambaran kasus secara ringkas.

Results / Discussion:
Tuliskan hasil utama atau pembahasan klinis yang relevan.

Conclusion:
Tuliskan kesimpulan dan implikasi klinis.

Keywords:
Keyword 1; Keyword 2; Keyword 3; Keyword 4; Keyword 5`;

    if (copyTemplateBtn && copyTemplateText) {
      copyTemplateBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(templateContent);
          const originalText = copyTemplateText.textContent;
          copyTemplateText.textContent = "✓ Template Berhasil Disalin!";
          copyTemplateBtn.classList.remove('bg-amber-400', 'text-slate-950');
          copyTemplateBtn.classList.add('bg-emerald-500', 'text-white');
          setTimeout(() => {
            copyTemplateText.textContent = originalText;
            copyTemplateBtn.classList.add('bg-amber-400', 'text-slate-950');
            copyTemplateBtn.classList.remove('bg-emerald-500', 'text-white');
          }, 2500);
        } catch (err) {
          console.error('Failed to copy text: ', err);
        }
      });
    }

    // Copy Subject Functionality
    const copySubjectBtn = document.getElementById('btn-copy-subject');
    if (copySubjectBtn) {
      copySubjectBtn.addEventListener('click', async () => {
        const text = copySubjectBtn.getAttribute('data-subject') || 'ABSTRACT – CPG 2026 – [Nama Penulis]';
        try {
          await navigator.clipboard.writeText(text);
          copySubjectBtn.textContent = '✓ Disalin';
          setTimeout(() => {
            copySubjectBtn.textContent = 'Salin';
          }, 2000);
        } catch (e) {
          console.error(e);
        }
      });
    }
  </script>

</EventLayout>
