---
import EventLayout from '../../layouts/EventLayout.astro';
import CCPGNavbar from '../../components/CCPGNavbar.astro';
import Medical3DVector from '../../components/Medical3DVector.astro';

const emailDestination = "Nanny.djaja@atmajaya.ac.id";
const emailSubject = "ABSTRACT – CPG 2026 – [Nama Penulis]";
const mailtoLink = `mailto:${emailDestination}?subject=${encodeURIComponent(emailSubject)}`;
const waContact = "+62 821-1101-3865";
const waLink = "https://wa.me/6282111013865?text=Halo%20dr.%20Danny%20Radja,%20saya%20ingin%20bertanya%20mengenai%20Call%20for%20Abstract%20CCPG%202026";
---

<EventLayout
  title="Call for Abstract - Current Clinical Practice Guidelines 2026 (#CCPG2026)"
  description="Kesempatan bagi Dokter, Dokter Spesialis, PPDS, Dokter Umum, dan Tenaga Kesehatan untuk berbagi hasil penelitian dan pengalaman klinis. Batas akhir: 30 Oktober 2026."
>

  <CCPGNavbar />

  <!-- MAIN WRAPPER -->
  <main class="relative bg-gradient-to-b from-slate-950 via-slate-900 to-slate-950 text-slate-100 overflow-hidden pb-24">
    
    <!-- Ambient 3D Glows -->
    <div class="vibrant-glow-blue w-[500px] h-[500px] -top-24 -left-20 opacity-35"></div>
    <div class="vibrant-glow-amber w-[550px] h-[550px] top-40 -right-20 opacity-30"></div>
    <div class="vibrant-glow-emerald w-96 h-96 bottom-40 left-1/4 opacity-25"></div>

    <!-- HERO HEADER SECTION -->
    <section class="pt-12 pb-16 relative z-10 border-b border-slate-800">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <!-- Breadcrumb & Back button -->
        <div class="mb-6 flex items-center justify-between">
          <a 
            href="/ccpg2026" 
            class="inline-flex items-center gap-2 text-xs sm:text-sm font-semibold text-amber-400 hover:text-amber-300 transition"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
            <span>Kembali ke Portal Simposium CCPG 2026</span>
          </a>

          <span class="px-3 py-1 rounded-full text-[11px] font-black bg-amber-400 text-slate-950 uppercase tracking-wider">
            Akreditasi B Kemenkes RI
          </span>
        </div>

        <!-- Badges Strip -->
        <div class="flex flex-wrap items-center gap-2 sm:gap-3 mb-6">
          <span class="px-3.5 py-1 rounded-full text-xs font-black bg-gradient-to-r from-amber-400 to-orange-400 text-slate-950 uppercase tracking-wider shadow-sm">
            CALL FOR ABSTRACT
          </span>
          <span class="px-3.5 py-1 rounded-full text-xs font-bold bg-sky-500/20 text-sky-300 border border-sky-400/30">
            CURRENT CLINICAL PRACTICE GUIDELINE 2026
          </span>
          <span class="px-3.5 py-1 rounded-full text-xs font-bold bg-rose-500/20 text-rose-300 border border-rose-400/40 flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-rose-400 animate-ping"></span>
            Deadline: 30 Oktober 2026
          </span>
        </div>

        <!-- Main Title & Subtitle -->
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white tracking-tight font-heading leading-tight">
          CALL FOR ABSTRACT
          <span class="block text-2xl sm:text-3xl lg:text-4xl text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-orange-300 to-amber-200 mt-2">
            CURRENT CLINICAL PRACTICE GUIDELINE 2026
          </span>
        </h1>

        <p class="text-base sm:text-lg text-slate-300 mt-4 leading-relaxed max-w-3xl">
          Kesempatan bagi <strong>Dokter, Dokter Spesialis, PPDS, Dokter Umum,</strong> dan <strong>Tenaga Kesehatan</strong> untuk berbagi hasil penelitian dan pengalaman klinis dalam perhelatan ilmiah medis nasional 9th CCPG 2026.
        </p>

        <!-- Key Info Highlights Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mt-8">
          <div class="p-4 rounded-2xl bg-slate-900/80 border border-slate-800 shadow-md">
            <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider block">Batas Akhir:</span>
            <p class="text-sm sm:text-base font-black text-amber-300 mt-1">30 Oktober 2026</p>
            <span class="text-[11px] text-slate-400">Pukul 23:59 WIB</span>
          </div>

          <div class="p-4 rounded-2xl bg-slate-900/80 border border-slate-800 shadow-md">
            <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider block">Bentuk Presentasi:</span>
            <p class="text-sm sm:text-base font-black text-white mt-1">Oral / E-Poster</p>
            <span class="text-[11px] text-sky-300">Sesuai hasil review juri</span>
          </div>

          <div class="p-4 rounded-2xl bg-slate-900/80 border border-slate-800 shadow-md">
            <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider block">Format Dokumen:</span>
            <p class="text-sm sm:text-base font-black text-white mt-1">MS Word (.doc / .docx)</p>
            <span class="text-[11px] text-slate-400">Maksimal 300 kata</span>
          </div>

          <div class="p-4 rounded-2xl bg-slate-900/80 border border-slate-800 shadow-md">
            <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider block">Email Pengiriman:</span>
            <a href={mailtoLink} class="text-xs sm:text-sm font-bold text-sky-400 hover:underline block truncate mt-1">
              {emailDestination}
            </a>
            <span class="text-[11px] text-slate-400">Subject: ABSTRACT - CPG 2026</span>
          </div>
        </div>

        <!-- Quick Action Buttons -->
        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a 
            href={waLink}
            target="_blank" 
            rel="noopener"
            class="px-6 py-3.5 rounded-xl bg-emerald-500 hover:bg-emerald-600 text-white font-bold text-sm shadow-lg shadow-emerald-500/25 transition transform hover:-translate-y-0.5 inline-flex items-center gap-2"
          >
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086s1.011.477 1.184.564.289.13.332.203c.044.072.044.419-.1.824z"/></svg>
            <span>Hubungi dr. Danny Radja (WhatsApp)</span>
          </a>

          <a 
            href={mailtoLink}
            class="px-6 py-3.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold text-sm border border-slate-700 transition inline-flex items-center gap-2"
          >
            <svg class="w-5 h-5 text-sky-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            <span>Kirim Email Pengiriman Abstrak</span>
          </a>

          <a 
            href="#template"
            class="px-5 py-3.5 rounded-xl bg-amber-400/10 hover:bg-amber-400/20 text-amber-300 font-bold text-sm border border-amber-400/30 transition inline-flex items-center gap-2"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
            <span>Salin Template Abstrak</span>
          </a>
        </div>

      </div>
    </section>


    <!-- SECTION 1: 3 KATEGORI ABSTRAK -->
    <section class="py-16 relative z-10">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="text-center max-w-2xl mx-auto mb-12">
          <span class="text-xs font-black tracking-widest text-amber-400 uppercase block mb-1">
            KLASIFIKASI KARYA ILMIAH
          </span>
          <h2 class="text-2xl sm:text-3xl font-black text-white font-heading">
            3 Kategori Abstrak yang Diterima
          </h2>
          <p class="text-sm text-slate-400 mt-2">
            Pilihlah salah satu dari tiga kategori di bawah ini sesuai dengan format penelitian atau laporan kasus klinis Anda.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          
          <!-- Kategori 1: Original Research -->
          <div class="p-6 rounded-3xl bg-slate-900/90 border-2 border-slate-800 hover:border-amber-400/50 transition duration-300 shadow-xl flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="w-9 h-9 rounded-xl bg-amber-400/20 text-amber-300 font-black flex items-center justify-center text-sm border border-amber-400/30">
                  1
                </span>
                <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 bg-slate-800 px-2.5 py-1 rounded-full">
                  Penelitian Original
                </span>
              </div>

              <h3 class="text-lg font-black text-white font-heading mb-3">
                Original Research
              </h3>
              <p class="text-xs text-slate-300 mb-5 leading-relaxed">
                Karya penelitian primer klinis, observasional, uji klinis, atau telaah analitik yang menghasilkan data baru.
              </p>

              <div class="space-y-2.5 border-t border-slate-800 pt-4">
                <span class="text-[11px] font-bold text-amber-300 uppercase tracking-wider block">
                  Struktur Wajib Abstrak:
                </span>
                <ul class="space-y-1.5 text-xs text-slate-300">
                  <li class="flex items-center gap-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
                    <strong>Background</strong> (Latar Belakang)
                  </li>
                  <li class="flex items-center gap-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
                    <strong>Objective</strong> (Tujuan Penelitian)
                  </li>
                  <li class="flex items-center gap-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
                    <strong>Methods</strong> (Metode Penelitian)
                  </li>
                  <li class="flex items-center gap-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
                    <strong>Results</strong> (Hasil & Temuan)
                  </li>
                  <li class="flex items-center gap-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
                    <strong>Conclusion</strong> (Kesimpulan)
                  </li>
                </ul>
              </div>
            </div>
          </div>

          <!-- Kategori 2: Case Report -->
          <div class="p-6 rounded-3xl bg-slate-900/90 border-2 border-slate-800 hover:border-sky-400/50 transition duration-300 shadow-xl flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="w-9 h-9 rounded-xl bg-sky-400/20 text-sky-300 font-black flex items-center justify-center text-sm border border-sky-400/30">
                  2
                </span>
                <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 bg-slate-800 px-2.5 py-1 rounded-full">
                  Laporan Kasus
                </span>
              </div>

              <h3 class="text-lg font-black text-white font-heading mb-3">
                Case Report
              </h3>
              <p class="text-xs text-slate-300 mb-5 leading-relaxed">
                Penyajian kasus klinis langka, manifestasi penyakit yang tidak lazim, respon terapi unik, atau dilema diagnosis.
              </p>

              <div class="space-y-2.5 border-t border-slate-800 pt-4">
                <span class="text-[11px] font-bold text-sky-300 uppercase tracking-wider block">
                  Struktur Wajib Abstrak:
                </span>
                <ul class="space-y-1.5 text-xs text-slate-300">
                  <li class="flex items-center gap-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-sky-400"></span>
                    <strong>Introduction</strong> (Pengantar Kasus)
                  </li>
                  <li class="flex items-center gap-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-sky-400"></span>
                    <strong>Case Presentation</strong> (Kronologi Kasus)
                  </li>
                  <li class="flex items-center gap-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-sky-400"></span>
                    <strong>Discussion</strong> (Pembahasan Klinis)
                  </li>
                  <li class="flex items-center gap-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-sky-400"></span>
                    <strong>Conclusion</strong> (Kesimpulan & Pesan Klinis)
                  </li>
                </ul>
              </div>
            </div>
          </div>

          <!-- Kategori 3: Evidence-Based Case Report (EBCR) -->
          <div class="p-6 rounded-3xl bg-slate-900/90 border-2 border-slate-800 hover:border-emerald-400/50 transition duration-300 shadow-xl flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="w-9 h-9 rounded-xl bg-emerald-400/20 text-emerald-300 font-black flex items-center justify-center text-sm border border-emerald-400/30">
                  3
                </span>
                <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 bg-slate-800 px-2.5 py-1 rounded-full">
                  EBM Terapan
                </span>
              </div>

              <h3 class="text-lg font-black text-white font-heading mb-3">
                Evidence-Based Case Report
              </h3>
              <p class="text-xs text-slate-300 mb-5 leading-relaxed">
                Laporan kasus berbasis bukti ilmiah (EBCR) yang menjawab pertanyaan klinis spesifik melalui telaah kritis literatur terkini.
              </p>

              <div class="space-y-2.5 border-t border-slate-800 pt-4">
                <span class="text-[11px] font-bold text-emerald-300 uppercase tracking-wider block">
                  Struktur Wajib Abstrak:
                </span>
                <ul class="space-y-1.5 text-xs text-slate-300">
                  <li class="flex items-center gap-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                    <strong>Clinical Question</strong> (Pertanyaan Klinis/PICO)
                  </li>
                  <li class="flex items-center gap-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                    <strong>Case Presentation</strong> (Gambaran Kasus)
                  </li>
                  <li class="flex items-center gap-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                    <strong>Evidence Search</strong> (Penelusuran Bukti)
                  </li>
                  <li class="flex items-center gap-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                    <strong>Critical Appraisal</strong> (Telaah Kritis Bukti)
                  </li>
                  <li class="flex items-center gap-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                    <strong>Conclusion</strong> (Kesimpulan Klinis)
                  </li>
                </ul>
              </div>
            </div>
          </div>

        </div>

      </div>
    </section>


    <!-- SECTION 2: TOPIK KLINIS -->
    <section class="py-16 bg-slate-950/70 border-y border-slate-800 relative z-10">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-8">
          <div>
            <span class="text-xs font-black tracking-widest text-sky-400 uppercase block mb-1">
              BIDANG KEAHLIAN & SPESIALISASI
            </span>
            <h2 class="text-2xl sm:text-3xl font-black text-white font-heading">
              Topik Pilihan Abstrak
            </h2>
            <p class="text-sm text-slate-300 mt-2 max-w-2xl leading-relaxed">
              Abstrak dapat berkaitan dengan implementasi <strong>Clinical Practice Guideline</strong> dalam pelayanan kedokteran, antara lain mencakup:
            </p>
          </div>
          
          <div class="shrink-0">
            <span class="px-3.5 py-1.5 rounded-xl bg-slate-800 text-xs font-semibold text-slate-300 border border-slate-700">
              Mencakup 13+ Bidang Klinis
            </span>
          </div>
        </div>

        <!-- Topics Grid -->
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3">
          {[
            { icon: "❤️", title: "Kardiovaskular", desc: "Jantung & Pembuluh Darah" },
            { icon: "🩺", title: "Diabetes & Metabolik", desc: "Endokrin & Terapi Terkini" },
            { icon: "🥗", title: "Obesitas & Nutrisi", desc: "Nutrisi Klinis & Dietetika" },
            { icon: "🦠", title: "Penyakit Infeksi", desc: "Tropis, Viral & Bakterial" },
            { icon: "🫁", title: "Pulmonologi", desc: "Respirasi & Paru" },
            { icon: "🧠", title: "Neurologi", desc: "Saraf, Stroke & Nyeri" },
            { icon: "🔬", title: "Gastroenterologi", desc: "Saluran Cerna & Hepatologi" },
            { icon: "💧", title: "Nefrologi", desc: "Ginjal & Hipertensi" },
            { icon: "👴", title: "Geriatri", desc: "Lanjut Usia & Multipatologi" },
            { icon: "🚑", title: "Kegawatdaruratan", desc: "Emergency & Critical Care" },
            { icon: "🏥", title: "Kedokteran Primer", desc: "Layanan Primer & FKTP" },
            { icon: "🏃", title: "Preventive & Lifestyle", desc: "Kedokteran Pencegahan" },
            { icon: "📋", title: "Topik Klinis Lainnya", desc: "Implementasi CPG Lintas Disiplin" },
          ].map((topic) => (
            <div class="p-3.5 rounded-2xl bg-slate-900/90 border border-slate-800 hover:border-sky-500/40 hover:bg-slate-850 transition flex items-start gap-3">
              <span class="text-2xl shrink-0 p-1 bg-slate-800/80 rounded-xl">{topic.icon}</span>
              <div>
                <h4 class="text-xs sm:text-sm font-bold text-white leading-tight">{topic.title}</h4>
                <p class="text-[10px] text-slate-400 mt-0.5">{topic.desc}</p>
              </div>
            </div>
          ))}
        </div>

      </div>
    </section>


    <!-- SECTION 3: KETENTUAN ABSTRAK & DEADLINE -->
    <section class="py-16 relative z-10">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
          
          <!-- Left: Ketentuan Penulisan -->
          <div class="lg:col-span-7 space-y-6">
            <div>
              <span class="text-xs font-black tracking-widest text-amber-400 uppercase block mb-1">
                STANDAR PENULISAN
              </span>
              <h2 class="text-2xl sm:text-3xl font-black text-white font-heading">
                Ketentuan & Tata Cara Abstrak
              </h2>
            </div>

            <div class="p-6 rounded-3xl bg-slate-900 border border-slate-800 space-y-4 shadow-xl">
              <ul class="space-y-3.5 text-xs sm:text-sm text-slate-300">
                <li class="flex items-start gap-3">
                  <div class="w-5 h-5 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center shrink-0 mt-0.5 font-bold text-xs">✓</div>
                  <div>
                    <strong>Panjang Abstrak:</strong> Maksimal <strong class="text-white">300 kata</strong> (tidak termasuk judul, nama penulis, dan afiliasi).
                  </div>
                </li>

                <li class="flex items-start gap-3">
                  <div class="w-5 h-5 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center shrink-0 mt-0.5 font-bold text-xs">✓</div>
                  <div>
                    <strong>Bahasa:</strong> Ditulis dalam <strong class="text-white">Bahasa Indonesia</strong> atau <strong class="text-white">Bahasa Inggris</strong> yang baik dan benar.
                  </div>
                </li>

                <li class="flex items-start gap-3">
                  <div class="w-5 h-5 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center shrink-0 mt-0.5 font-bold text-xs">✓</div>
                  <div>
                    <strong>Kata Kunci:</strong> Maksimal <strong class="text-white">5 keywords</strong>, dipisahkan dengan tanda titik koma (;).
                  </div>
                </li>

                <li class="flex items-start gap-3">
                  <div class="w-5 h-5 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center shrink-0 mt-0.5 font-bold text-xs">✓</div>
                  <div>
                    <strong>Penulisan Nama Penulis:</strong> Nama penulis ditulis <strong>lengkap tanpa gelar</strong> akademis/profesi.
                  </div>
                </li>

                <li class="flex items-start gap-3">
                  <div class="w-5 h-5 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center shrink-0 mt-0.5 font-bold text-xs">✓</div>
                  <div>
                    <strong>Afiliasi:</strong> Wajib mencantumkan <strong>institusi / rumah sakit / universitas</strong> beserta nama kota.
                  </div>
                </li>

                <li class="flex items-start gap-3">
                  <div class="w-5 h-5 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center shrink-0 mt-0.5 font-bold text-xs">✓</div>
                  <div>
                    <strong>Format File:</strong> Abstrak wajib dikirim dalam format <strong class="text-white">Microsoft Word (.doc / .docx)</strong>.
                  </div>
                </li>

                <li class="flex items-start gap-3">
                  <div class="w-5 h-5 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center shrink-0 mt-0.5 font-bold text-xs">✓</div>
                  <div>
                    <strong>Proses Telaah:</strong> Semua abstrak akan melalui <strong>proses review</strong> oleh tim penilai ilmiah.
                  </div>
                </li>

                <li class="flex items-start gap-3">
                  <div class="w-5 h-5 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center shrink-0 mt-0.5 font-bold text-xs">✓</div>
