---
// ScrollWorld.astro - simple GSAP scroll-triggered fade-in
---
<div class="scroll-world">
  <slot />
</div>

<style>
  .scroll-world > * {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.6s ease-out, transform 0.6s ease-out;
  }
  .scroll-world > *.visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  // Animate elements with class 'animate' when they enter viewport
  gsap.utils.toArray('.animate').forEach((elem) => {
    gsap.from(elem, {
      scrollTrigger: {
        trigger: elem,
        start: 'top 80%',
        end: 'bottom 20%',
        toggleClass: { targets: elem, className: 'visible' },
      },
      opacity: 0,
      y: 20,
      duration: 0.8,
      ease: 'power3.out',
    });
  });
</script>