---
import Medical3DVector from './Medical3DVector.astro';
---

<footer class="bg-slate-900 text-slate-300 pt-16 pb-12 border-t border-slate-800 relative overflow-hidden">
  <!-- Subtle Background Glows -->
  <div class="vibrant-glow-blue w-96 h-96 -top-20 -left-20 opacity-30"></div>
  <div class="vibrant-glow-amber w-96 h-96 bottom-0 right-0 opacity-20"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Highlight Callout Box to CCPG 2026 -->
    <div class="mb-14 p-6 sm:p-8 rounded-2xl bg-gradient-to-r from-sky-950 via-slate-800 to-sky-900 border border-sky-700/40 shadow-2xl flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="flex items-center gap-4">
        <div class="w-14 h-14 rounded-2xl bg-amber-500/20 border border-amber-400/40 flex items-center justify-center shrink-0 text-3xl">
          🎓
        </div>
        <div>
          <div class="flex items-center gap-2 flex-wrap">
            <span class="px-2 py-0.5 rounded-full text-[11px] font-black bg-amber-400 text-slate-950">
              OFFLINE SYMPOSIUM
            </span>
            <span class="text-xs text-sky-300 font-semibold">
              7-8 November 2026 • RS Carolus Jakarta
            </span>
          </div>
          <h4 class="text-lg sm:text-xl font-bold text-white mt-1 font-heading">
            9th Current Clinical Practice Guidelines (#CCPG2026)
          </h4>
          <p class="text-xs sm:text-sm text-slate-300 max-w-2xl">
            Penguatan Kompetensi Klinis Dokter melalui EBM, Precision Medicine & Artificial Intelligence.
          </p>
        </div>
      </div>
      <div class="flex items-center gap-3 shrink-0 w-full md:w-auto">
        <a 
          href="/ccpg2026" 
          class="w-full md:w-auto text-center px-6 py-3 rounded-xl bg-gradient-to-r from-amber-400 to-amber-500 hover:from-amber-300 hover:to-amber-400 text-slate-950 font-black text-sm shadow-lg transition transform hover:-translate-y-0.5"
        >
          Kunjungi ccpg2026.kmki.or.id &rarr;
        </a>
      </div>
    </div>

    <!-- Main 4-Column Footer -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 pb-12 border-b border-slate-800">
      
      <!-- Col 1 & 2: Organization Info -->
      <div class="lg:col-span-2 space-y-4">
        <div class="flex items-center gap-3">
          <img src="/images/logo.jpg" alt="KMKI Logo" class="w-12 h-12 rounded-full border border-sky-400/30 bg-white" />
          <div>
            <h3 class="text-xl font-black text-white tracking-tight font-heading">KMKI Indonesia</h3>
            <p class="text-xs text-slate-400">Komunitas Medik Katolik Indonesia</p>
          </div>
        </div>
        <p class="text-sm text-slate-400 leading-relaxed max-w-md">
          Wadah perhimpunan tenaga medis dan dokter Katolik di Indonesia yang didirikan pada 11 Februari 2001. Berkomitmen menegakkan nilai-nilai moral Kristiani, etika kedokteran, bioetika, serta keunggulan profesional dalam pelayanan kesehatan bangsa.
        </p>
        <div class="pt-1">
          <p class="text-xs text-slate-400">
            Alamat: <strong class="text-slate-200 font-medium">Jl. Janur Elok 1 QB 7 No.1, Kelapa Gading, Jakarta 14240, Indonesia</strong>
          </p>
        </div>
      </div>

      <!-- Col 3: Navigasi Cepat -->
      <div>
        <h4 class="text-sm font-bold text-white uppercase tracking-wider mb-4 border-l-2 border-sky-500 pl-2 font-heading">
          Navigasi Cepat
        </h4>
        <ul class="space-y-2.5 text-sm">
          <li><a href="/tentang" class="hover:text-sky-400 transition">Tentang KMKI & Sejarah</a></li>
          <li><a href="/pelayanan" class="hover:text-sky-400 transition">Pilar & Karya Pelayanan</a></li>
          <li><a href="/keuskupan" class="hover:text-sky-400 transition">Jaringan 20 Keuskupan</a></li>
          <li><a href="/ccpg2026" class="hover:text-sky-400 transition font-bold text-amber-400">🎓 Simposium CCPG 2026</a></li>
          <li><a href="/kontak" class="hover:text-sky-400 transition">Kontak Kami</a></li>
        </ul>
      </div>

      <!-- Col 4: Keuskupan & Regional -->
      <div>
        <h4 class="text-sm font-bold text-white uppercase tracking-wider mb-4 border-l-2 border-sky-500 pl-2 font-heading">
          Wilayah Keuskupan
        </h4>
        <ul class="space-y-2 text-xs text-slate-400">
          <li><span class="text-slate-300 font-medium">KMKI KAJ</span> (Keuskupan Agung Jakarta)</li>
          <li><span class="text-slate-300 font-medium">KMKI KAS</span> (Keuskupan Agung Semarang)</li>
          <li><span class="text-slate-300 font-medium">KMKI Bandung & Bogor</span></li>
          <li><span class="text-slate-300 font-medium">KMKI Surabaya & Malang</span></li>
          <li><span class="text-slate-300 font-medium">KMKI Medan & Palembang</span></li>
          <li><span class="text-slate-300 font-medium">KMKI Pontianak & Banjarmasin</span></li>
          <li><span class="text-slate-300 font-medium">KMKI Makassar & Manado</span></li>
          <li><a href="/keuskupan" class="text-sky-400 hover:underline">Lihat semua 20 wilayah &rarr;</a></li>
        </ul>
      </div>

      <!-- Col 5: Kontak Kami -->
      <div>
        <h4 class="text-sm font-bold text-white uppercase tracking-wider mb-4 border-l-2 border-sky-500 pl-2 font-heading">
          Kontak Kami
        </h4>
        <div class="space-y-3 text-xs">
          <div>
            <span class="block text-slate-500">Alamat:</span>
            <span class="text-slate-200">Jl. Janur Elok 1 QB 7 No.1, Kelapa Gading, Jakarta 14240, Indonesia</span>
          </div>
          <div>
            <span class="block text-slate-500">Telepon:</span>
            <a href="tel:0214515601" class="text-sky-400 font-bold hover:underline">
              Telp. 021-451-5601
            </a>
          </div>
          <div>
            <span class="block text-slate-500">Email Resmi:</span>
            <a href="mailto:sekretariat@kmki.or.id" class="text-sky-400 hover:underline">sekretariat@kmki.or.id</a>
          </div>
        </div>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <p>&copy; 2026 Komunitas Medik Katolik Indonesia (KMKI). All rights reserved.</p>
      <div class="flex items-center gap-6">
        <a href="/tentang" class="hover:text-slate-400 transition">Bioetika Katolik</a>
        <a href="/ccpg2026" class="hover:text-slate-400 transition">🎓 CCPG 2026 Portal</a>
        <a href="/kontak" class="hover:text-slate-400 transition">Kontak Kami</a>
      </div>
    </div>
  </div>
</footer>
