<script>
  const form = document.getElementById('kaj-membership-form') as HTMLFormElement | null;
  const modal = document.getElementById('form-success-modal');
  const btnClose = document.getElementById('btn-close-modal');

  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      
      const subject = `[Pendaftaran Anggota KMKI KAJ] ${fd.get('nama_gelar')} - ${fd.get('gelar')}`;
      
      let body = `FORMULIR PENDAFTARAN ANGGOTA KMKI WILAYAH KAJ\n`;
      body += `==============================================\n\n`;
      body += `1. IDENTITAS & KONTAK:\n`;
      body += `Nama Lengkap & Gelar : ${fd.get('nama_gelar')}\n`;
      body += `No. Telepon / HP 1   : ${fd.get('telepon_1')}\n`;
      body += `Email 1              : ${fd.get('email_1')}\n`;
      if (fd.get('telepon_2')) body += `No. Telepon / HP 2   : ${fd.get('telepon_2')}\n`;
      if (fd.get('email_2'))   body += `Email 2              : ${fd.get('email_2')}\n`;
      body += `\n2. PROFESI & PENDIDIKAN:\n`;
      body += `Gelar / Kategori     : ${fd.get('gelar')}\n`;
      if (fd.get('nakes_lainnya')) body += `Tenaga Kesehatan Lain: ${fd.get('nakes_lainnya')}\n`;
      body += `Asal Universitas     : ${fd.get('universitas')}\n`;
      if (fd.get('tahun_masuk'))   body += `Tahun Masuk          : ${fd.get('tahun_masuk')}\n`;
      body += `Tempat Bekerja       : ${fd.get('tempat_bekerja')}\n`;
      body += `\n3. TANGGAL LAHIR:\n`;
      body += `Tanggal Lahir        : ${fd.get('tanggal_lahir')} ${fd.get('bulan_lahir')} ${fd.get('tahun_lahir')}\n`;
      body += `\n4. DOMISILI & GEREJAWI:\n`;
      body += `Alamat Lengkap       : ${fd.get('alamat_domisili')}\n`;
      body += `Kabupaten            : ${fd.get('kabupaten')}\n`;
      body += `Kota                 : ${fd.get('kota')}\n`;
      body += `Dekenat              : ${fd.get('dekenat')}\n`;
      if (fd.get('dekenat_luar'))  body += `Dekenat Luar KAJ     : ${fd.get('dekenat_luar')}\n`;
      body += `Paroki               : ${fd.get('paroki')}\n`;
      if (fd.get('paroki_luar'))   body += `Paroki Luar KAJ      : ${fd.get('paroki_luar')}\n`;
      body += `\n==============================================\n`;
      body += `Catatan: Pemohon memahami kewajiban iuran anggota Rp 50.000 / 10 tahun untuk pembuatan KTA.\n`;

      if (modal) {
        modal.classList.remove('hidden');
      }

      // Open mailto
      const mailtoUrl = `mailto:kaj@kmki.or.id?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      setTimeout(() => {
        window.location.href = mailtoUrl;
      }, 600);
    });
  }

  if (btnClose && modal) {
    btnClose.addEventListener('click', () => {
      modal.classList.add('hidden');
      if (form) form.reset();
    });
  }
</script>
