---
// KAJ Membership Registration Form Component
// Faithful to the specifications & fields from https://kmkikaj.my.id/keanggotaan/pendaftaran-anggota-2/
---

<div class="max-w-4xl mx-auto">
  
  <!-- Info Cards Header: Syarat, Langkah, Keuntungan -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
    
    <!-- Syarat Pendaftaran -->
    <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm flex flex-col justify-between">
      <div>
        <div class="w-10 h-10 rounded-xl bg-sky-100 text-sky-700 flex items-center justify-center font-bold text-lg mb-4">
          📋
        </div>
        <h3 class="text-base font-bold text-slate-900 mb-3 font-heading">
          Syarat Pendaftaran Anggota
        </h3>
        <ul class="space-y-2 text-xs text-slate-600 leading-relaxed">
          <li class="flex items-start gap-2">
            <span class="text-sky-600 font-bold">•</span>
            <span>Merupakan Sarjana Kedokteran/Kedokteran Gigi, Dokter Umum/Dokter Gigi, atau Dokter Spesialis/Dokter Gigi Spesialis.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-sky-600 font-bold">•</span>
            <span>Beragama Katolik.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-sky-600 font-bold">•</span>
            <span>Mengisi formulir pendaftaran anggota secara lengkap.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-sky-600 font-bold">•</span>
            <span>Membayar iuran anggota <strong class="text-slate-900">Rp 50.000,- per 10 tahun</strong> untuk biaya administrasi pembuatan kartu tanda anggota (KTA).</span>
          </li>
        </ul>
      </div>
    </div>

    <!-- Langkah Pendaftaran -->
    <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm flex flex-col justify-between">
      <div>
        <div class="w-10 h-10 rounded-xl bg-amber-100 text-amber-800 flex items-center justify-center font-bold text-lg mb-4">
          👣
        </div>
        <h3 class="text-base font-bold text-slate-900 mb-3 font-heading">
          Langkah Pendaftaran Anggota
        </h3>
        <ol class="space-y-2.5 text-xs text-slate-600 leading-relaxed list-decimal list-inside">
          <li><strong>Mengisi form pendaftaran</strong> di bawah ini secara lengkap dan benar.</li>
          <li>Anda akan <strong>dihubungi melalui email</strong> oleh sekretariat untuk konfirmasi data.</li>
          <li><strong>Mengumpulkan foto</strong> dan konfirmasi pembayaran iuran administrasi (Rp 50.000,-).</li>
          <li><strong>Pengiriman kartu tanda anggota (KTA)</strong> resmi KMKI Wilayah KAJ.</li>
        </ol>
      </div>
    </div>

    <!-- Keuntungan Menjadi Anggota -->
    <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm flex flex-col justify-between">
      <div>
        <div class="w-10 h-10 rounded-xl bg-emerald-100 text-emerald-800 flex items-center justify-center font-bold text-lg mb-4">
          🌟
        </div>
        <h3 class="text-base font-bold text-slate-900 mb-3 font-heading">
          Keuntungan Menjadi Anggota
        </h3>
        <p class="text-xs text-slate-600 leading-relaxed">
          Menambah relasi profesional dan persaudaraan seiman, menambah informasi klinis dan regulasi kesehatan terkini, dapat bertukar informasi ilmiah dengan rekan sejawat lain, serta dapat mengikuti kegiatan rohani bersama-sama (Misa St. Lukas, Rekoleksi, dan Ziarah Rekreasi).
        </p>
      </div>
      <div class="mt-4 pt-3 border-t border-slate-100 text-[11px] text-slate-400">
        Paguyuban nakes Katolik di Keuskupan Agung Jakarta
      </div>
    </div>

  </div>

  <!-- Form Pendaftaran -->
  <div class="bg-white rounded-3xl p-6 sm:p-10 border border-slate-200 shadow-xl relative overflow-hidden">
    
    <div class="mb-8 pb-6 border-b border-slate-200">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-sky-100 text-sky-800 text-xs font-bold uppercase tracking-wider mb-2">
        Formulir Resmi KMKI KAJ
      </div>
      <h2 class="text-2xl sm:text-3xl font-black text-slate-900 font-heading">
        Formulir Pendaftaran Anggota Baru
      </h2>
      <p class="text-xs sm:text-sm text-slate-500 mt-1">
        Silakan isi data diri Anda dengan teliti. Tanda bintang (<span class="text-rose-500 font-bold">*</span>) wajib diisi.
      </p>
    </div>

    <form id="kaj-membership-form" class="space-y-8">

      <!-- BAGIAN 1: IDENTITAS & KONTAK -->
      <div>
        <h3 class="text-sm font-bold uppercase tracking-wider text-sky-800 border-b border-sky-100 pb-2 mb-4 font-heading flex items-center gap-2">
          <span class="w-6 h-6 rounded-full bg-sky-600 text-white text-xs flex items-center justify-center font-mono">1</span>
          Identitas & Informasi Kontak
        </h3>

        <div class="space-y-4">
          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">
              Nama berikut gelar <span class="text-rose-500">*</span>
            </label>
            <input 
              type="text" 
              name="nama_gelar" 
              required 
              placeholder="Contoh: dr. Albertus Pratama, Sp.A / drg. Maria Fransiska" 
              class="w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-sky-500 bg-slate-50/50"
            />
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">
                No. Telepon / HP 1 <span class="text-rose-500">*</span>
              </label>
              <input 
                type="tel" 
                name="telepon_1" 
                required 
                placeholder="0812-xxxx-xxxx" 
                class="w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-sky-500 bg-slate-50/50"
              />
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">
                Email 1 <span class="text-rose-500">*</span>
              </label>
              <input 
                type="email" 
                name="email_1" 
                required 
                placeholder="dokter@gmail.com" 
                class="w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-sky-500 bg-slate-50/50"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">
                No. Telepon / HP 2 <span class="text-slate-400 font-normal">(Opsional)</span>
              </label>
              <input 
                type="tel" 
                name="telepon_2" 
                placeholder="Nomor alternatif" 
                class="w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-sky-500 bg-slate-50/50"
              />
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">
                Email 2 <span class="text-slate-400 font-normal">(Opsional)</span>
              </label>
              <input 
                type="email" 
                name="email_2" 
                placeholder="Email institusi / alternatif" 
                class="w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-sky-500 bg-slate-50/50"
              />
            </div>
          </div>
        </div>
      </div>

      <!-- BAGIAN 2: PROFESI & PENDIDIKAN -->
      <div>
        <h3 class="text-sm font-bold uppercase tracking-wider text-sky-800 border-b border-sky-100 pb-2 mb-4 font-heading flex items-center gap-2">
          <span class="w-6 h-6 rounded-full bg-sky-600 text-white text-xs flex items-center justify-center font-mono">2</span>
          Profesi & Pendidikan
        </h3>

        <div class="space-y-4">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">
                Gelar / Kategori Profesi <span class="text-rose-500">*</span>
              </label>
              <select 
                name="gelar" 
                id="select-gelar"
                required 
                class="w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-sky-500 bg-slate-50/50"
              >
                <option value="" disabled selected>Pilih Kategori Profesi...</option>
                <option value="Sarjana Kedokteran">Sarjana Kedokteran</option>
                <option value="Sarjana Kedokteran Gigi">Sarjana Kedokteran Gigi</option>
                <option value="Dokter Umum">Dokter Umum</option>
                <option value="Dokter Gigi">Dokter Gigi</option>
                <option value="Perawat / Tenaga Kesehatan lainnya">Perawat / Tenaga Kesehatan lainnya</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">
                Tenaga kesehatan lainnya <span class="text-slate-400 font-normal">(Jika memilih nakes lainnya)</span>
              </label>
              <input 
                type="text" 
                name="nakes_lainnya" 
                placeholder="Contoh: Apoteker, Fisioterapis, Perawat" 
                class="w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-sky-500 bg-slate-50/50"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div class="sm:col-span-2">
              <label class="block text-xs font-semibold text-slate-700 mb-1">
                Asal Universitas <span class="text-rose-500">*</span>
              </label>
              <input 
                type="text" 
                name="universitas" 
                required 
                placeholder="Contoh: FKIK Unika Atma Jaya Jakarta / FK UI" 
                class="w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-sky-500 bg-slate-50/50"
              />
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">
                Tahun Masuk
              </label>
              <input 
                type="number" 
                name="tahun_masuk" 
                placeholder="Contoh: 2012" 
                min="1950" 
                max="2030"
                class="w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-sky-500 bg-slate-50/50"
              />
            </div>
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">
              Tempat Bekerja / Institusi Pelayanan Medis <span class="text-rose-500">*</span>
            </label>
            <input 
              type="text" 
              name="tempat_bekerja" 
              required 
              placeholder="Contoh: RS St. Carolus Salemba / Puskesmas / Klinik / Praktik Mandiri" 
              class="w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-sky-500 bg-slate-50/50"
            />
          </div>
        </div>
      </div>

      <!-- BAGIAN 3: DATA KELAHIRAN -->
      <div>
        <h3 class="text-sm font-bold uppercase tracking-wider text-sky-800 border-b border-sky-100 pb-2 mb-4 font-heading flex items-center gap-2">
          <span class="w-6 h-6 rounded-full bg-sky-600 text-white text-xs flex items-center justify-center font-mono">3</span>
          Tanggal Lahir
        </h3>

        <div class="grid grid-cols-3 gap-4">
          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">
              Tanggal Lahir <span class="text-rose-500">*</span>
            </label>
            <input 
              type="number" 
              name="tanggal_lahir" 
              required 
              min="1" 
              max="31" 
              placeholder="1 - 31" 
              class="w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-sky-500 bg-slate-50/50"
            />
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">
              Bulan Lahir <span class="text-rose-500">*</span>
            </label>
            <select 
              name="bulan_lahir" 
              required 
              class="w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-sky-500 bg-slate-50/50"
            >
              <option value="" disabled selected>Pilih Bulan...</option>
              <option value="Januari">Januari</option>
              <option value="Februari">Februari</option>
              <option value="Maret">Maret</option>
              <option value="April">April</option>
              <option value="Mei">Mei</option>
              <option value="Juni">Juni</option>
              <option value="Juli">Juli</option>
              <option value="Agustus">Agustus</option>
              <option value="September">September</option>
              <option value="Oktober">Oktober</option>
              <option value="November">November</option>
              <option value="Desember">Desember</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">
              Tahun Lahir <span class="text-rose-500">*</span>
            </label>
            <input 
              type="number" 
              name="tahun_lahir" 
              required 
              min="1920" 
              max="2015" 
              placeholder="Contoh: 1988" 
              class="w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-sky-500 bg-slate-50/50"
            />
          </div>
        </div>
      </div>

      <!-- BAGIAN 4: DOMISILI & WILAYAH GEREJAWI -->
      <div>
        <h3 class="text-sm font-bold uppercase tracking-wider text-sky-800 border-b border-sky-100 pb-2 mb-4 font-heading flex items-center gap-2">
          <span class="w-6 h-6 rounded-full bg-sky-600 text-white text-xs flex items-center justify-center font-mono">4</span>
          Domisili & Wilayah Gerejawi (KAJ)
        </h3>

        <div class="space-y-4">
          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">
              Alamat Tempat Tinggal / Domisili <span class="text-rose-500">*</span>
            </label>
            <textarea 
              name="alamat_domisili" 
              rows="3" 
              required 
              placeholder="Alamat lengkap (nama jalan, nomor, RT/RW, kelurahan, kecamatan)" 
              class="w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-sky-500 bg-slate-50/50"
            ></textarea>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">
                Kabupaten Tempat Tinggal / Domisili <span class="text-rose-500">*</span>
              </label>
              <input 
                type="text" 
                name="kabupaten" 
                required 
                placeholder="Contoh: Jakarta Utara / Tangerang / Bekasi" 
                class="w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-sky-500 bg-slate-50/50"
              />
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">
                Kota Tempat Tinggal / Domisili <span class="text-rose-500">*</span>
              </label>
              <input 
                type="text" 
                name="kota" 
                required 
                placeholder="Contoh: Jakarta / Tangerang Selatan / Bekasi" 
                class="w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-sky-500 bg-slate-50/50"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">
                Dekenat <span class="text-rose-500">*</span>
              </label>
              <select 
                name="dekenat" 
                id="select-dekenat"
                required 
                class="w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-sky-500 bg-slate-50/50"
              >
                <option value="" disabled selected>Pilih Dekenat KAJ...</option>
                <option value="Jakarta Utara">Jakarta Utara</option>
                <option value="Jakarta Timur">Jakarta Timur</option>
                <option value="Jakarta Barat">Jakarta Barat</option>
                <option value="Jakarta Pusat">Jakarta Pusat</option>
                <option value="Jakarta Selatan">Jakarta Selatan</option>
                <option value="Bekasi">Bekasi</option>
                <option value="Tangerang">Tangerang</option>
                <option value="Luar KAJ">Luar KAJ</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">
                Dekenat (Luar KAJ) <span class="text-slate-400 font-normal">(Jika memilih Luar KAJ)</span>
              </label>
              <input 
                type="text" 
                name="dekenat_luar" 
                placeholder="Tuliskan nama dekenat/keuskupan luar KAJ" 
                class="w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-sky-500 bg-slate-50/50"
              />
            </div>
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">
              Paroki <span class="text-rose-500">*</span>
            </label>
            <select 
              name="paroki" 
              id="select-paroki"
              required 
              class="w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-sky-500 bg-slate-50/50"
            >
              <option value="" disabled selected>Pilih Paroki Anda...</option>
              <!-- Jakarta Utara -->
              <optgroup label="Dekenat Jakarta Utara">
                <option value="Jakarta Utara, St. Yakobus, KELAPA GADING">Jakarta Utara, St. Yakobus, KELAPA GADING</option>
                <option value="Jakarta Utara, ST LUKAS, SUNTER">Jakarta Utara, ST LUKAS, SUNTER</option>
                <option value="Jakarta Utara, St. Yohanes don Bosko, DANAU SUNTER">Jakarta Utara, St. Yohanes don Bosko, DANAU SUNTER</option>
                <option value="Jakarta Utara, REGINA CAELI , Pantai Indah Kapuk">Jakarta Utara, REGINA CAELI , Pantai Indah Kapuk</option>
                <option value="Jakarta Utara, Salib Suci, CILINCING">Jakarta Utara, Salib Suci, CILINCING</option>
                <option value="Jakarta Utara, St. Alfonsus Rodriguez, PADEMANGAN">Jakarta Utara, St. Alfonsus Rodriguez, PADEMANGAN</option>
                <option value="Jakarta Utara, St. Fransiskus Xaverius, TANJUNG PRIOK">Jakarta Utara, St. Fransiskus Xaverius, TANJUNG PRIOK</option>
                <option value="Jakarta Utara, Stella Maris, PLUIT">Jakarta Utara, Stella Maris, PLUIT</option>
              </optgroup>
              <!-- Jakarta Timur -->
              <optgroup label="Dekenat Jakarta Timur">
                <option value="Jakarta Timur, St. Antonius Padua, BIDARACINA">Jakarta Timur, St. Antonius Padua, BIDARACINA</option>
                <option value="Jakarta Timur, St. Aloysius Gonzaga CIJANTUNG">Jakarta Timur, St. Aloysius Gonzaga CIJANTUNG</option>
                <option value="Jakarta Timur, St. Robertus Bellarminus, CILILITAN">Jakarta Timur, St. Robertus Bellarminus, CILILITAN</option>
                <option value="Jakarta Timur, St. Anna, DUREN SAWIT">Jakarta Timur, St. Anna, DUREN SAWIT</option>
                <option value="Jakarta Timur, St. Yosep, MATRAMAN">Jakarta Timur, St. Yosep, MATRAMAN</option>
                <option value="Jakarta Timur, St. Bonaventura, PULOMAS">Jakarta Timur, St. Bonaventura, PULOMAS</option>
                <option value="Jakarta Timur, St. Gabriel , PULO GEBANG">Jakarta Timur, St. Gabriel , PULO GEBANG</option>
                <option value="Jakarta Timur, Keluarga Kudus, RAWAMANGUN">Jakarta Timur, Keluarga Kudus, RAWAMANGUN</option>
                <option value="Jakarta Timur, St. Yohanes Maria Vianney , CILANGKAP">Jakarta Timur, St. Yohanes Maria Vianney , CILANGKAP</option>
              </optgroup>
              <!-- Jakarta Barat -->
              <optgroup label="Dekenat Jakarta Barat">
                <option value="Jakarta Barat, Maria Bunda Perantara , CIDENG">Jakarta Barat, Maria Bunda Perantara , CIDENG</option>
                <option value="Jakarta Barat, Damai Kristus, KAMPUNG DURI">Jakarta Barat, Damai Kristus, KAMPUNG DURI</option>
                <option value="Jakarta Barat, Bunda Hati Kudus , KEMAKMURAN">Jakarta Barat, Bunda Hati Kudus , KEMAKMURAN</option>
                <option value="Jakarta Barat, St. Petrus & Paulus , MANGGA BESAR">Jakarta Barat, St. Petrus & Paulus , MANGGA BESAR</option>
                <option value="Jakarta Barat, Kristus Salvator , SLIPI">Jakarta Barat, Kristus Salvator , SLIPI</option>
                <option value="Jakarta Barat, St. Maria De Fatima, TOASEBIO">Jakarta Barat, St. Maria De Fatima, TOASEBIO</option>
                <option value="Jakarta Barat, St. Thomas Rasul, BOJONG INDAH">Jakarta Barat, St. Thomas Rasul, BOJONG INDAH</option>
                <option value="Jakarta Barat, Trinitas, CENGKARENG">Jakarta Barat, Trinitas, CENGKARENG</option>
                <option value="Jakarta Barat, St. Kristoforus, GROGOL">Jakarta Barat, St. Kristoforus, GROGOL</option>
                <option value="Jakarta Barat, St. Andreas, KEDOYA">Jakarta Barat, St. Andreas, KEDOYA</option>
                <option value="Jakarta Barat, St. Matias Rasul , KOSAMBI BARU">Jakarta Barat, St. Matias Rasul , KOSAMBI BARU</option>
                <option value="Jakarta Barat, Maria Kusuma Karmel, MERUYA">Jakarta Barat, Maria Kusuma Karmel, MERUYA</option>
                <option value="Jakarta Barat, St. Philipus Rasul , KAPUK">Jakarta Barat, St. Philipus Rasul , KAPUK</option>
                <option value="Jakarta Barat, Maria Bunda Karmel, TOMANG">Jakarta Barat, Maria Bunda Karmel, TOMANG</option>
                <option value="Jakarta Barat, St. Maria Imakulata, KALIDERES">Jakarta Barat, St. Maria Imakulata, KALIDERES</option>
              </optgroup>
              <!-- Jakarta Pusat -->
              <optgroup label="Dekenat Jakarta Pusat">
                <option value="Jakarta Pusat, St. Ignatius, JL. MALANG">Jakarta Pusat, St. Ignatius, JL. MALANG</option>
                <option value="Jakarta Pusat, SP. Maria diangkat ke Surga, KATEDRAL">Jakarta Pusat, SP. Maria diangkat ke Surga, KATEDRAL</option>
                <option value="Jakarta Pusat, Kristus Raja, PEJOMPONGAN">Jakarta Pusat, Kristus Raja, PEJOMPONGAN</option>
                <option value="Jakarta Pusat, ST. THERESIA">Jakarta Pusat, ST. THERESIA</option>
