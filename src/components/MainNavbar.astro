---
import DomainSwitcher from './DomainSwitcher.astro';
---

<!-- Domain Switcher Bar at the top -->
<DomainSwitcher currentHighlight="main" />

<!-- Top Utility Bar -->
<div class="bg-sky-900 text-white text-xs py-2 px-4 border-b border-sky-800">
  <div class="max-w-7xl mx-auto flex flex-wrap justify-between items-center gap-3">
    <div class="flex items-center gap-4 sm:gap-6">
      <a href="tel:0214515601" class="flex items-center gap-1.5 hover:text-sky-200 transition font-medium">
        <svg class="w-3.5 h-3.5 text-sky-400" fill="currentColor" viewBox="0 0 16 16">
          <path d="M1.885.511a1.745 1.745 0 0 1 2.61.163L6.29 2.98c.329.423.445.974.315 1.494l-.547 2.19a.68.68 0 0 0 .178.643l2.457 2.457a.68.68 0 0 0 .644.178l2.189-.547a1.75 1.75 0 0 1 1.494.315l2.306 1.794c.829.645.905 1.87.163 2.611l-1.034 1.034c-.74.74-1.846 1.065-2.877.702a18.6 18.6 0 0 1-7.01-4.42a18.6 18.6 0 0 1-4.42-7.009c-.362-1.03-.037-2.137.703-2.877z"/>
        </svg>
        <span>Telp. 021-451-5601</span>
      </a>
      <a href="mailto:sekretariat@kmki.or.id" class="hidden sm:flex items-center gap-1.5 hover:text-sky-200 transition">
        <svg class="w-3.5 h-3.5 text-sky-400" fill="currentColor" viewBox="0 0 16 16">
          <path d="M.05 3.555A2 2 0 0 1 2 2h12a2 2 0 0 1 1.95 1.555L8 8.414zM0 4.697v7.104l5.803-3.558zM6.761 8.83l-6.57 4.027A2 2 0 0 0 2 14h12a2 2 0 0 0 1.808-1.144l-6.57-4.027L8 9.586zm3.436-.586L16 11.801V4.697z"/>
        </svg>
        <span>sekretariat@kmki.or.id</span>
      </a>
    </div>

    <div class="flex items-center gap-3">
      <a href="/ccpg2026" class="bg-amber-400 hover:bg-amber-300 text-slate-950 font-bold px-3 py-0.5 rounded text-xs transition shadow-xs flex items-center gap-1.5">
        <span>🎓</span>
        <span>CCPG 2026</span>
        <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>
  </div>
</div>

<!-- Main Sticky Header -->
<header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-slate-200/80 shadow-xs">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand Logo & Name -->
      <a href="/" class="flex items-center gap-3 group">
        <div class="relative w-12 h-12 rounded-full overflow-hidden p-0.5 bg-gradient-to-tr from-sky-600 via-amber-400 to-sky-400 shadow-md group-hover:scale-105 transition transform">
          <img src="/images/logo.jpg" alt="KMKI Logo" class="w-full h-full object-cover rounded-full bg-white" />
        </div>
        <div class="flex flex-col">
          <div class="flex items-center gap-1.5">
            <span class="text-xl sm:text-2xl font-black tracking-tight text-slate-900 group-hover:text-sky-700 transition font-heading">
              KMKI
            </span>
            <span class="px-1.5 py-0.5 text-[10px] font-bold rounded bg-sky-100 text-sky-800 uppercase tracking-wide">
              Indonesia
            </span>
          </div>
          <span class="text-xs text-slate-500 font-medium line-clamp-1">
            Komunitas Medik Katolik Indonesia
          </span>
        </div>
      </a>

      <!-- Desktop Navigation Menu (Menu Beranda dan Pendaftaran Anggota KMKI dihilangkan) -->
      <nav class="hidden lg:flex items-center gap-2 text-sm font-medium text-slate-700">
        <a href="/tentang" class="px-3.5 py-2 rounded-lg hover:text-sky-700 hover:bg-sky-50 transition">
          Tentang KMKI
        </a>
        <a href="/pelayanan" class="px-3.5 py-2 rounded-lg hover:text-sky-700 hover:bg-sky-50 transition">
          Pilar Pelayanan
        </a>
        <a href="/keuskupan" class="px-3.5 py-2 rounded-lg hover:text-sky-700 hover:bg-sky-50 transition">
          20 Keuskupan
        </a>
        <a href="/kontak" class="px-3.5 py-2 rounded-lg hover:text-sky-700 hover:bg-sky-50 transition">
          Kontak Kami
        </a>

        <!-- Highlight Badge Button for Event -->
        <a 
          href="/ccpg2026" 
          class="relative ml-2 inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs font-bold bg-gradient-to-r from-amber-400 to-amber-500 text-slate-950 shadow-xs hover:shadow-md transition group"
        >
          <span>🎓</span>
          <span>CCPG 2026</span>
          <span class="bg-slate-950/15 text-slate-950 text-[10px] px-1.5 py-0.5 rounded-full font-black">
            7-8 Nov
          </span>
        </a>
      </nav>

      <!-- Right Action CTA: CCPG 2026 -->
      <div class="hidden sm:flex items-center gap-3">
        <a 
          href="/ccpg2026" 
          class="inline-flex items-center justify-center gap-1.5 px-5 py-2.5 rounded-xl text-sm font-bold text-white bg-gradient-to-r from-sky-600 via-sky-700 to-blue-800 hover:from-sky-500 hover:to-blue-700 shadow-md hover:shadow-lg transition transform hover:-translate-y-0.5"
        >
          <span>🎓 Simposium CCPG 2026</span>
        </a>
      </div>

      <!-- Mobile Menu Toggle Button -->
      <button 
        id="main-mobile-menu-btn" 
        type="button" 
        class="lg:hidden p-2 rounded-lg text-slate-700 hover:bg-slate-100 transition focus:outline-none focus:ring-2 focus:ring-sky-500"
        aria-label="Buka Menu"
        aria-expanded="false"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>

    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="main-mobile-menu" class="lg:hidden hidden border-t border-slate-200 bg-white/95 backdrop-blur-md px-4 py-4 space-y-2">
    <a href="/tentang" class="block px-3 py-2 rounded-lg text-slate-800 font-medium hover:bg-sky-50">Tentang KMKI</a>
    <a href="/pelayanan" class="block px-3 py-2 rounded-lg text-slate-800 font-medium hover:bg-sky-50">Pilar Pelayanan</a>
    <a href="/keuskupan" class="block px-3 py-2 rounded-lg text-slate-800 font-medium hover:bg-sky-50">20 Keuskupan Wilayah</a>
    <a href="/kontak" class="block px-3 py-2 rounded-lg text-slate-800 font-medium hover:bg-sky-50">Kontak Kami</a>
    <div class="pt-2 border-t border-slate-100">
      <a href="/ccpg2026" class="block text-center py-2.5 px-4 rounded-xl bg-gradient-to-r from-amber-400 to-amber-500 text-slate-950 font-bold text-sm shadow">
        🎓 Simposium CCPG 2026 (7-8 Nov)
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('main-mobile-menu-btn');
  const menu = document.getElementById('main-mobile-menu');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!isExpanded));
      menu.classList.toggle('hidden');
    });
  }
</script>
