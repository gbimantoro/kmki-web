---

<div class="space-y-8" id="speaker-section">
  
  <!-- Category Filter Buttons -->
  <div class="flex flex-wrap items-center justify-center gap-2">
    <button type="button" data-cat="all" class="cat-filter-btn px-4 py-2 rounded-xl text-xs font-bold bg-amber-400 text-slate-950 transition active-cat">
      Semua Pakar ({speakers.length})
    </button>
    <button type="button" data-cat="ai-etika" class="cat-filter-btn px-4 py-2 rounded-xl text-xs font-bold bg-slate-800 text-slate-300 hover:text-white transition">
      AI & Etika Digital
    </button>
    <button type="button" data-cat="metabolik" class="cat-filter-btn px-4 py-2 rounded-xl text-xs font-bold bg-slate-800 text-slate-300 hover:text-white transition">
      Obesitas, DM & Metabolik
    </button>
    <button type="button" data-cat="kardio" class="cat-filter-btn px-4 py-2 rounded-xl text-xs font-bold bg-slate-800 text-slate-300 hover:text-white transition">
      Kardiovaskular & Ginjal
    </button>
    <button type="button" data-cat="pediatri" class="cat-filter-btn px-4 py-2 rounded-xl text-xs font-bold bg-slate-800 text-slate-300 hover:text-white transition">
      Kesehatan Anak
    </button>
    <button type="button" data-cat="imunologi" class="cat-filter-btn px-4 py-2 rounded-xl text-xs font-bold bg-slate-800 text-slate-300 hover:text-white transition">
      Alergi, Imun & Reuma
    </button>
    <button type="button" data-cat="wanita" class="cat-filter-btn px-4 py-2 rounded-xl text-xs font-bold bg-slate-800 text-slate-300 hover:text-white transition">
      Kesehatan Wanita & Onko
    </button>
    <button type="button" data-cat="neuro" class="cat-filter-btn px-4 py-2 rounded-xl text-xs font-bold bg-slate-800 text-slate-300 hover:text-white transition">
      Saraf, Jiwa & Nyeri
    </button>
    <button type="button" data-cat="geriatri" class="cat-filter-btn px-4 py-2 rounded-xl text-xs font-bold bg-slate-800 text-slate-300 hover:text-white transition">
      Geriatri & Healthy Aging
    </button>
  </div>

  <!-- Speaker Cards Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="speaker-grid">
    {speakers.map((sp) => (
      <div 
        class="speaker-card glass-panel-dark p-6 rounded-2xl border border-slate-800 hover:border-amber-400/50 hover:shadow-2xl transition duration-300 flex flex-col justify-between group"
        data-category={sp.category}
      >
        <div>
          <!-- Header Tag -->
          <div class="flex items-center justify-between gap-2 mb-4">
            <span class="px-2.5 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-slate-800 text-amber-300 border border-amber-400/20">
              {sp.badge}
            </span>
            <span class="w-8 h-8 rounded-full bg-slate-800 flex items-center justify-center text-slate-400 group-hover:text-amber-400 transition">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
              </svg>
            </span>
          </div>

          <!-- Doctor Name & Credentials -->
          <h4 class="text-base font-bold text-white group-hover:text-amber-300 transition leading-snug">
            {sp.name}
          </h4>

          <p class="text-xs text-slate-400 mt-1 font-medium line-clamp-2">
            {sp.specialty}
          </p>
        </div>

        <!-- Lecture Topic / Role -->
        <div class="mt-4 pt-3 border-t border-slate-800/80">
          <span class="text-[10px] text-slate-500 uppercase tracking-wider block font-semibold">Materi / Topik:</span>
          <p class="text-xs text-sky-200 font-medium mt-0.5 line-clamp-2">
            "{sp.role}"
          </p>
        </div>
      </div>
    ))}
  </div>

</div>

<script>
  const catBtns = document.querySelectorAll('.cat-filter-btn');
  const cards = document.querySelectorAll('.speaker-card');

  catBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const cat = btn.getAttribute('data-cat');
      catBtns.forEach(b => {
        b.classList.remove('bg-amber-400', 'text-slate-950');
        b.classList.add('bg-slate-800', 'text-slate-300');
      });
      btn.classList.add('bg-amber-400', 'text-slate-950');
      btn.classList.remove('bg-slate-800', 'text-slate-300');

      cards.forEach((card) => {
        const itemCat = card.getAttribute('data-category');
        if (cat === 'all' || itemCat === cat) {
          (card as HTMLElement).style.display = '';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>
