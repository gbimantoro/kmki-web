---
---

<header class="sticky top-0 z-40 bg-slate-900/95 backdrop-blur-md border-b border-slate-800 shadow-xl">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand Logo & Title: Structured & Harmonious Layout -->
      <a href="/ccpg2026" class="flex items-center gap-3 group">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-amber-400 to-amber-500 text-slate-950 flex items-center justify-center font-black text-xl shadow-md shadow-amber-500/20 group-hover:scale-105 transition transform shrink-0">
          🎓
        </div>
        <div class="flex flex-col">
          <div class="flex items-center gap-2">
            <span class="text-lg sm:text-xl font-black tracking-tight text-white group-hover:text-amber-400 transition font-heading leading-tight">
              CCPG 2026
            </span>
            <span class="px-1.5 py-0.5 text-[9px] font-black rounded bg-amber-400 text-slate-950 uppercase tracking-wider">
              9th Edition
            </span>
          </div>
          <div class="flex items-center gap-1.5 text-[11px] text-slate-400 font-medium leading-tight mt-0.5">
            <span class="hidden sm:inline">Current Clinical Practice Guidelines</span>
            <span class="hidden sm:inline text-slate-600">•</span>
            <span class="bg-amber-400 text-slate-950 font-black px-1.5 py-0.2 rounded text-[10px] whitespace-nowrap">
              7-8 Nov 2026
            </span>
          </div>
        </div>
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden lg:flex items-center gap-6 text-sm font-medium text-slate-300">
        <a href="/ccpg2026#jadwal" class="hover:text-amber-400 transition">Jadwal</a>
        <a href="/ccpg2026#pembicara" class="hover:text-amber-400 transition">Narasumber</a>
        <a href="/call-for-poster" class="text-amber-400 hover:text-amber-300 transition font-bold flex items-center gap-1.5 bg-amber-400/10 px-2.5 py-1 rounded-lg border border-amber-400/30 shadow-sm">
          <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
          <span>Call for Poster</span>
        </a>
        <a href="/ccpg2026#lokasi" class="hover:text-amber-400 transition">Lokasi</a>
      </nav>

      <!-- Right Action CTA -->
      <div class="hidden sm:flex items-center gap-3">
        <a 
          href="https://wa.me/message/5DNKURZLG6SWD1" 
          target="_blank" 
          rel="noopener"
          class="inline-flex items-center justify-center px-5 py-2.5 rounded-xl text-xs font-black text-slate-950 bg-gradient-to-r from-amber-400 to-amber-500 hover:from-amber-300 hover:to-amber-400 shadow-md transition transform hover:-translate-y-0.5"
        >
          Daftar Simposium
        </a>
      </div>

      <!-- Mobile Button -->
      <button 
        id="ccpg-mobile-btn" 
        type="button" 
        class="lg:hidden p-2 rounded-lg text-slate-300 hover:bg-slate-800 transition"
        aria-label="Menu CCPG 2026"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>

    </div>
  </div>

  <!-- Mobile Dropdown -->
  <div id="ccpg-mobile-menu" class="lg:hidden hidden border-t border-slate-800 bg-slate-900/98 px-4 py-4 space-y-2">
    <a href="/call-for-poster" class="block px-3 py-2.5 rounded-lg text-amber-300 font-bold text-sm bg-amber-400/15 hover:bg-slate-800 flex items-center justify-between border border-amber-400/40">
      <span class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
        <span>Call for Poster</span>
      </span>
      <span class="text-[10px] bg-amber-400 text-slate-950 px-2 py-0.5 rounded font-black">Batas 30 Okt</span>
    </a>
    <a href="/ccpg2026#jadwal" class="block px-3 py-2 rounded-lg text-slate-200 text-sm hover:bg-slate-800">Jadwal</a>
    <a href="/ccpg2026#pembicara" class="block px-3 py-2 rounded-lg text-slate-200 text-sm hover:bg-slate-800">Narasumber</a>
    <a href="/ccpg2026#lokasi" class="block px-3 py-2 rounded-lg text-slate-200 text-sm hover:bg-slate-800">Lokasi</a>
    <div class="pt-2">
      <a href="https://wa.me/message/5DNKURZLG6SWD1" target="_blank" rel="noopener" class="block text-center py-2.5 px-4 rounded-xl bg-gradient-to-r from-amber-400 to-amber-500 text-slate-950 font-black text-sm">
        Daftar via WhatsApp (0851-9060-5900)
      </a>
    </div>
  </div>
</header>

<script>
  const ccpgBtn = document.getElementById('ccpg-mobile-btn');
  const ccpgMenu = document.getElementById('ccpg-mobile-menu');
  if (ccpgBtn && ccpgMenu) {
    ccpgBtn.addEventListener('click', () => {
      ccpgMenu.classList.toggle('hidden');
    });
  }
</script>
