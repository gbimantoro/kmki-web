---
---

<header class="sticky top-0 z-40 bg-slate-900/95 backdrop-blur-md border-b border-slate-800 shadow-xl">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand Title: CCPG 2026 9th edition directly -->
      <a href="/ccpg2026" class="flex items-center gap-2.5 group">
        <div class="flex items-center gap-2">
          <span class="text-xl sm:text-2xl font-black tracking-tight text-white group-hover:text-amber-400 transition font-heading">
            CCPG 2026
          </span>
          <span class="px-2 py-0.5 text-[10px] font-black rounded bg-amber-400 text-slate-950 uppercase tracking-wider">
            9th Edition
          </span>
        </div>
        <p class="text-[11px] text-slate-400 font-medium hidden sm:block border-l border-slate-700 pl-2.5">
          Current Clinical Practice Guidelines • 7-8 Nov 2026
        </p>
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden lg:flex items-center gap-6 text-sm font-medium text-slate-300">
        <a href="#tentang" class="hover:text-amber-400 transition">Tentang</a>
        <a href="#akreditasi" class="hover:text-amber-400 transition">Akreditasi & SKP</a>
        <a href="#jadwal" class="hover:text-amber-400 transition">Jadwal Sesi</a>
        <a href="#pembicara" class="hover:text-amber-400 transition">18+ Pakar Spesialis</a>
        <a href="#biaya" class="hover:text-amber-400 transition">Investasi</a>
        <a href="#lokasi" class="hover:text-amber-400 transition">Lokasi & Venue</a>
      </nav>

      <!-- Right Action CTA -->
      <div class="hidden sm:flex items-center gap-3">
        <a 
          href="#biaya" 
          class="inline-flex items-center justify-center px-4 py-2.5 rounded-xl text-xs font-semibold text-slate-300 bg-slate-800 hover:bg-slate-700 transition border border-slate-700"
        >
          Tarif: Rp 300rb / 400rb
        </a>
        <a 
          href="https://wa.me/message/5DNKURZLG6SWD1" 
          target="_blank" 
          rel="noopener"
          class="inline-flex items-center justify-center px-5 py-2.5 rounded-xl text-xs font-black text-slate-950 bg-gradient-to-r from-amber-400 to-amber-500 hover:from-amber-300 hover:to-amber-400 shadow-md transition transform hover:-translate-y-0.5"
        >
          Daftar Simposium
        </a>
      </div>

      <!-- Mobile Button -->
      <button 
        id="ccpg-mobile-btn" 
        type="button" 
        class="lg:hidden p-2 rounded-lg text-slate-300 hover:bg-slate-800 transition"
        aria-label="Menu CCPG 2026"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>

    </div>
  </div>

  <!-- Mobile Dropdown -->
  <div id="ccpg-mobile-menu" class="lg:hidden hidden border-t border-slate-800 bg-slate-900/98 px-4 py-4 space-y-2">
    <a href="#tentang" class="block px-3 py-2 rounded-lg text-slate-200 text-sm hover:bg-slate-800">Tentang Simposium</a>
    <a href="#akreditasi" class="block px-3 py-2 rounded-lg text-slate-200 text-sm hover:bg-slate-800">Akreditasi B Kemenkes & SKP</a>
    <a href="#jadwal" class="block px-3 py-2 rounded-lg text-slate-200 text-sm hover:bg-slate-800">Jadwal Sesi 7-8 Nov</a>
    <a href="#pembicara" class="block px-3 py-2 rounded-lg text-slate-200 text-sm hover:bg-slate-800">Daftar 18 Pembicara Spesialis</a>
    <a href="#biaya" class="block px-3 py-2 rounded-lg text-slate-200 text-sm hover:bg-slate-800">Biaya Pendaftaran</a>
    <a href="#lokasi" class="block px-3 py-2 rounded-lg text-slate-200 text-sm hover:bg-slate-800">Lokasi RS Carolus</a>
    <div class="pt-2">
      <a href="https://wa.me/message/5DNKURZLG6SWD1" target="_blank" rel="noopener" class="block text-center py-2.5 px-4 rounded-xl bg-gradient-to-r from-amber-400 to-amber-500 text-slate-950 font-black text-sm">
        Daftar via WhatsApp (0851-9060-5900)
      </a>
    </div>
  </div>
</header>

<script>
  const ccpgBtn = document.getElementById('ccpg-mobile-btn');
  const ccpgMenu = document.getElementById('ccpg-mobile-menu');
  if (ccpgBtn && ccpgMenu) {
    ccpgBtn.addEventListener('click', () => {
      ccpgMenu.classList.toggle('hidden');
    });
  }
</script>
