---
interface Props {
  name: 'stethoscope-ai' | 'cross-asclepius' | 'dna-helix' | 'brain-ai' | 'shield-check' | 'heart-pulse' | 'hospital' | 'award-skp' | 'doctor-male' | 'doctor-female' | 'pill-capsule' | 'microscope';
  class?: string;
  size?: number;
}

const { name, class: className = '', size = 64 } = Astro.props;
---

<div class={`inline-flex items-center justify-center shrink-0 ${className}`} style={`width: ${size}px; height: ${size}px;`}>
  {name === 'stethoscope-ai' && (
    <svg viewBox="0 0 120 120" width={size} height={size} fill="none" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="grad-blue-3d" x1="10%" y1="0%" x2="90%" y2="100%">
          <stop offset="0%" stop-color="#38bdf8" />
          <stop offset="50%" stop-color="#0284c7" />
          <stop offset="100%" stop-color="#0369a1" />
        </linearGradient>
        <linearGradient id="grad-gold-3d" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#fef08a" />
          <stop offset="50%" stop-color="#f59e0b" />
          <stop offset="100%" stop-color="#b45309" />
        </linearGradient>
        <linearGradient id="grad-cyan-glow" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#67e8f9" />
          <stop offset="100%" stop-color="#06b6d4" />
        </linearGradient>
        <filter id="shadow-3d" x="-20%" y="-20%" width="140%" height="140%">
          <feDropShadow dx="3" dy="6" stdDeviation="4" flood-color="#0369a1" flood-opacity="0.3" />
        </filter>
      </defs>
      <!-- Base Glowing Disc -->
      <circle cx="60" cy="60" r="52" fill="url(#grad-blue-3d)" opacity="0.12" />
      <circle cx="60" cy="60" r="44" fill="white" filter="url(#shadow-3d)" />
      
      <!-- Stethoscope Tube in 3D -->
      <path d="M40 32 V52 C40 68 80 68 80 52 V32" stroke="url(#grad-blue-3d)" stroke-width="6" stroke-linecap="round" />
      <!-- Binaural Earpieces -->
      <circle cx="40" cy="30" r="5" fill="url(#grad-gold-3d)" filter="url(#shadow-3d)" />
      <circle cx="80" cy="30" r="5" fill="url(#grad-gold-3d)" filter="url(#shadow-3d)" />
      <!-- Central Tube to Chestpiece -->
      <path d="M60 62 V78 C60 88 74 90 74 94" stroke="url(#grad-blue-3d)" stroke-width="6" stroke-linecap="round" />
      <!-- Chestpiece 3D -->
      <circle cx="76" cy="95" r="14" fill="url(#grad-gold-3d)" filter="url(#shadow-3d)" />
      <circle cx="76" cy="95" r="9" fill="white" />
      <circle cx="76" cy="95" r="6" fill="url(#grad-cyan-glow)" />
      <!-- AI Digital Pulse sparks -->
      <path d="M30 65 L36 65 L40 58 L46 72 L50 63 L56 65" stroke="#10b981" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
      <circle cx="46" cy="72" r="2.5" fill="#10b981" />
    </svg>
  )}

  {name === 'cross-asclepius' && (
    <svg viewBox="0 0 120 120" width={size} height={size} fill="none" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="grad-cross" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#fef08a" />
          <stop offset="40%" stop-color="#eab308" />
          <stop offset="100%" stop-color="#ca8a04" />
        </linearGradient>
        <linearGradient id="grad-snake" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#38bdf8" />
          <stop offset="50%" stop-color="#0284c7" />
          <stop offset="100%" stop-color="#0f172a" />
        </linearGradient>
        <filter id="cross-shadow" x="-20%" y="-20%" width="140%" height="140%">
          <feDropShadow dx="2" dy="5" stdDeviation="4" flood-color="#ca8a04" flood-opacity="0.35" />
        </filter>
      </defs>
      <!-- Background Halo -->
      <circle cx="60" cy="60" r="50" fill="#fef3c7" opacity="0.6" />
      <circle cx="60" cy="60" r="42" fill="white" />
      
      <!-- 3D Catholic Cross (Budded/Trefoil Cross) -->
      <g filter="url(#cross-shadow)">
        <!-- Vertical Bar -->
        <rect x="54" y="20" width="12" height="80" rx="4" fill="url(#grad-cross)" />
        <!-- Horizontal Bar -->
        <rect x="28" y="38" width="64" height="12" rx="4" fill="url(#grad-cross)" />
        <!-- Cross Knobs -->
        <circle cx="60" cy="18" r="6" fill="url(#grad-cross)" />
        <circle cx="60" cy="102" r="6" fill="url(#grad-cross)" />
        <circle cx="26" cy="44" r="6" fill="url(#grad-cross)" />
        <circle cx="94" cy="44" r="6" fill="url(#grad-cross)" />
      </g>

      <!-- Rod of Asclepius Snake entwining the cross -->
      <path d="M52 88 C70 82 72 74 60 68 C46 62 48 52 64 48 C72 46 72 38 60 34" stroke="url(#grad-snake)" stroke-width="4.5" stroke-linecap="round" />
      <!-- Snake head -->
      <ellipse cx="60" cy="33" rx="4.5" ry="3.5" fill="#0284c7" />
      <circle cx="61" cy="32" r="1" fill="white" />
    </svg>
  )}

  {name === 'dna-helix' && (
    <svg viewBox="0 0 120 120" width={size} height={size} fill="none" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="grad-dna-1" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#38bdf8" />
          <stop offset="100%" stop-color="#0284c7" />
        </linearGradient>
        <linearGradient id="grad-dna-2" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#34d399" />
          <stop offset="100%" stop-color="#059669" />
        </linearGradient>
        <filter id="dna-shadow" x="-20%" y="-20%" width="140%" height="140%">
          <feDropShadow dx="2" dy="5" stdDeviation="4" flood-color="#0284c7" flood-opacity="0.25" />
        </filter>
      </defs>
      <circle cx="60" cy="60" r="50" fill="#f0f9ff" />
      <!-- Strand 1 -->
      <path d="M40 24 C80 40 80 56 40 72 C80 88 80 100 40 104" stroke="url(#grad-dna-1)" stroke-width="5" stroke-linecap="round" />
      <!-- Strand 2 -->
      <path d="M80 24 C40 40 40 56 80 72 C40 88 40 100 80 104" stroke="url(#grad-dna-2)" stroke-width="5" stroke-linecap="round" />
      <!-- Base Pairs Rungs -->
      <line x1="45" y1="30" x2="75" y2="34" stroke="#94a3b8" stroke-width="3" stroke-linecap="round" />
      <circle cx="45" cy="30" r="4" fill="#38bdf8" />
      <circle cx="75" cy="34" r="4" fill="#34d399" />

      <line x1="56" y1="48" x2="64" y2="48" stroke="#94a3b8" stroke-width="3" stroke-linecap="round" />
      <circle cx="60" cy="48" r="4" fill="#f59e0b" />

      <line x1="45" y1="66" x2="75" y2="62" stroke="#94a3b8" stroke-width="3" stroke-linecap="round" />
      <circle cx="45" cy="66" r="4" fill="#34d399" />
      <circle cx="75" cy="62" r="4" fill="#38bdf8" />

      <line x1="56" y1="80" x2="64" y2="80" stroke="#94a3b8" stroke-width="3" stroke-linecap="round" />
      <circle cx="60" cy="80" r="4" fill="#f59e0b" />

      <line x1="45" y1="98" x2="75" y2="94" stroke="#94a3b8" stroke-width="3" stroke-linecap="round" />
      <circle cx="45" cy="98" r="4" fill="#38bdf8" />
      <circle cx="75" cy="94" r="4" fill="#34d399" />
    </svg>
  )}

  {name === 'brain-ai' && (
    <svg viewBox="0 0 120 120" width={size} height={size} fill="none" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="grad-brain" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#818cf8" />
          <stop offset="50%" stop-color="#6366f1" />
          <stop offset="100%" stop-color="#4338ca" />
        </linearGradient>
        <linearGradient id="grad-neural" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#38bdf8" />
          <stop offset="100%" stop-color="#06b6d4" />
        </linearGradient>
      </defs>
      <circle cx="60" cy="60" r="50" fill="#eef2ff" />
      <!-- Left Brain Hemisphere (Humanistic) -->
      <path d="M58 28 C42 28 32 38 32 52 C32 60 36 66 34 72 C32 78 36 88 48 90 C56 92 58 84 58 84" stroke="url(#grad-brain)" stroke-width="4.5" stroke-linecap="round" fill="#e0e7ff" fill-opacity="0.4" />
      <path d="M42 46 C48 50 48 60 40 66" stroke="url(#grad-brain)" stroke-width="3.5" stroke-linecap="round" />
      
      <!-- Right Brain Hemisphere (AI Circuits & Nodes) -->
      <path d="M62 28 C78 28 88 38 88 52 C88 60 84 66 86 72 C88 78 84 88 72 90 C64 92 62 84 62 84" stroke="url(#grad-neural)" stroke-width="4" stroke-linecap="round" stroke-dasharray="3 3" />
      
      <!-- AI Neural Nodes -->
      <circle cx="74" cy="40" r="4.5" fill="#0284c7" />
      <circle cx="82" cy="56" r="4" fill="#38bdf8" />
      <circle cx="70" cy="68" r="5" fill="#6366f1" />
      <circle cx="80" cy="80" r="3.5" fill="#10b981" />
      
      <line x1="74" y1="40" x2="82" y2="56" stroke="#0284c7" stroke-width="2" />
      <line x1="82" y1="56" x2="70" y2="68" stroke="#6366f1" stroke-width="2" />
      <line x1="70" y1="68" x2="80" y2="80" stroke="#10b981" stroke-width="2" />

      <!-- Center Spark -->
      <circle cx="60" cy="56" r="3" fill="#f59e0b" />
    </svg>
  )}

  {name === 'shield-check' && (
    <svg viewBox="0 0 120 120" width={size} height={size} fill="none" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="grad-shield" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#34d399" />
          <stop offset="60%" stop-color="#059669" />
          <stop offset="100%" stop-color="#065f46" />
        </linearGradient>
        <filter id="shield-shadow" x="-20%" y="-20%" width="140%" height="140%">
          <feDropShadow dx="2" dy="5" stdDeviation="4" flood-color="#059669" flood-opacity="0.3" />
        </filter>
      </defs>
      <circle cx="60" cy="60" r="50" fill="#ecfdf5" />
      <!-- Shield 3D -->
      <path d="M60 22 L86 32 C86 64 74 86 60 98 C46 86 34 64 34 32 L60 22 Z" fill="url(#grad-shield)" filter="url(#shield-shadow)" />
      <!-- Inner Glow -->
      <path d="M60 27 L81 35 C81 62 71 80 60 90 C49 80 39 62 39 35 L60 27 Z" fill="#10b981" opacity="0.4" />
      <!-- White Checkmark -->
      <path d="M48 58 L56 66 L74 46" stroke="white" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  )}

  {name === 'heart-pulse' && (
    <svg viewBox="0 0 120 120" width={size} height={size} fill="none" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="grad-heart" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#fb7185" />
          <stop offset="60%" stop-color="#e11d48" />
          <stop offset="100%" stop-color="#9f1239" />
        </linearGradient>
        <filter id="heart-shadow" x="-20%" y="-20%" width="140%" height="140%">
          <feDropShadow dx="2" dy="5" stdDeviation="4" flood-color="#e11d48" flood-opacity="0.35" />
        </filter>
      </defs>
      <circle cx="60" cy="60" r="50" fill="#fff1f2" />
      <!-- Heart 3D -->
      <path d="M60 94 C32 76 22 58 22 42 C22 28 32 20 44 20 C52 20 58 26 60 30 C62 26 68 20 76 20 C88 20 98 28 98 42 C98 58 88 76 60 94 Z" fill="url(#grad-heart)" filter="url(#heart-shadow)" />
      <!-- ECG Line in White -->
      <path d="M30 52 H44 L49 40 L55 64 L62 46 L67 56 L73 52 H90" stroke="white" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  )}

  {name === 'hospital' && (
    <svg viewBox="0 0 120 120" width={size} height={size} fill="none" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="grad-hospital" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#38bdf8" />
          <stop offset="100%" stop-color="#0284c7" />
        </linearGradient>
      </defs>
      <circle cx="60" cy="60" r="50" fill="#f0f9ff" />
      <!-- Building Base -->
      <rect x="34" y="36" width="52" height="60" rx="6" fill="#e0f2fe" stroke="url(#grad-hospital)" stroke-width="4" />
      <!-- Roof Header -->
      <rect x="38" y="24" width="44" height="14" rx="3" fill="#0284c7" />
      <!-- Red/Catholic Cross on Hospital -->
      <rect x="57" y="44" width="6" height="16" rx="2" fill="#ef4444" />
      <rect x="52" y="49" width="16" height="6" rx="2" fill="#ef4444" />
      <!-- Windows Grid -->
      <rect x="42" y="68" width="8" height="8" rx="2" fill="#38bdf8" />
      <rect x="56" y="68" width="8" height="8" rx="2" fill="#38bdf8" />
      <rect x="70" y="68" width="8" height="8" rx="2" fill="#38bdf8" />
      <rect x="54" y="82" width="12" height="14" rx="2" fill="#0284c7" />
    </svg>
  )}

  {name === 'award-skp' && (
    <svg viewBox="0 0 120 120" width={size} height={size} fill="none" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="grad-award" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#fde047" />
          <stop offset="60%" stop-color="#eab308" />
          <stop offset="100%" stop-color="#a16207" />
        </linearGradient>
      </defs>
      <circle cx="60" cy="60" r="50" fill="#fefce8" />
      <!-- Ribbons -->
      <path d="M46 72 L36 104 L52 94 L64 104 L58 74" fill="#0284c7" />
      <path d="M74 72 L84 104 L68 94 L56 104 L62 74" fill="#0369a1" />
      <!-- Medal Circle -->
      <circle cx="60" cy="52" r="28" fill="url(#grad-award)" filter="drop-shadow(0 4px 6px rgba(161, 98, 7, 0.3))" />
      <circle cx="60" cy="52" r="22" fill="#fef9c3" />
      <!-- Star / Cross in Center -->
      <path d="M60 38 L63 47 L72 48 L65 54 L68 63 L60 57 L52 63 L55 54 L48 48 L57 47 Z" fill="#eab308" />
    </svg>
  )}

  {name === 'pill-capsule' && (
    <svg viewBox="0 0 120 120" width={size} height={size} fill="none" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="grad-pill-blue" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#38bdf8" />
          <stop offset="100%" stop-color="#0284c7" />
        </linearGradient>
        <linearGradient id="grad-pill-orange" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#fb923c" />
          <stop offset="100%" stop-color="#ea580c" />
        </linearGradient>
      </defs>
      <circle cx="60" cy="60" r="50" fill="#fff7ed" />
      <g transform="rotate(-45 60 60)">
        <rect x="42" y="32" width="36" height="28" rx="18" fill="url(#grad-pill-blue)" />
        <rect x="42" y="60" width="36" height="28" rx="18" fill="url(#grad-pill-orange)" />
        <line x1="42" y1="60" x2="78" y2="60" stroke="white" stroke-width="2" />
        <ellipse cx="50" cy="42" rx="4" ry="8" fill="white" opacity="0.6" />
      </g>
    </svg>
  )}

  {name === 'microscope' && (
    <svg viewBox="0 0 120 120" width={size} height={size} fill="none" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="grad-micro" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#38bdf8" />
          <stop offset="100%" stop-color="#0f766e" />
        </linearGradient>
      </defs>
      <circle cx="60" cy="60" r="50" fill="#f0fdfa" />
      <!-- Base -->
      <rect x="32" y="92" width="56" height="8" rx="4" fill="#334155" />
      <!-- Arm -->
      <path d="M72 92 C72 68 84 56 74 42" stroke="#475569" stroke-width="8" stroke-linecap="round" />
      <!-- Tube -->
      <g transform="rotate(-30 52 44)">
        <rect x="44" y="22" width="16" height="34" rx="4" fill="url(#grad-micro)" />
        <circle cx="52" cy="18" r="7" fill="#0284c7" />
        <rect x="48" y="56" width="8" height="10" fill="#f59e0b" />
      </g>
      <!-- Stage -->
      <rect x="40" y="74" width="30" height="5" rx="2" fill="#64748b" />
    </svg>
  )}
</div>
