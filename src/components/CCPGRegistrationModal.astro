---
import Medical3DVector from './Medical3DVector.astro';
---

<div class="space-y-12" id="daftar-container">
  
  <!-- Pricing Comparison Cards -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
    
    <!-- Dokter Umum Card -->
    <div class="relative glass-panel-dark p-8 rounded-3xl border-2 border-slate-700 hover:border-sky-400 transition duration-300 flex flex-col justify-between group">
      <div>
        <div class="flex items-center justify-between gap-2 mb-4">
          <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-sky-500/20 text-sky-300 border border-sky-400/30">
            Kategori Dokter Umum
          </span>
          <span class="text-xs text-slate-400">Offline Simposium</span>
        </div>

        <h3 class="text-2xl font-black text-white font-heading">Dokter Umum / Residen</h3>
        <p class="text-xs text-slate-400 mt-1">Praktisi layanan primer, puskesmas, klinik & mahasiswa PPDS</p>

        <div class="mt-6 flex items-baseline gap-2">
          <span class="text-xs text-slate-400 font-semibold">Investasi:</span>
          <span class="text-4xl font-black text-white font-mono">Rp 300.000</span>
          <span class="text-xs text-slate-400">/ peserta</span>
        </div>

        <ul class="mt-6 space-y-2.5 text-xs text-slate-300">
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
            <span>Akses Penuh 2 Hari Simposium (7-8 Nov 2026)</span>
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
            <span>Nilai SKP Kemenkes RI (Akreditasi B) via Plataran Sehat</span>
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
            <span>Seminar Kit Eksklusif & E-Sertifikat Resmi</span>
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
            <span>Coffee Break & Lunch Simposium 2 Hari Penuh</span>
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
            <span>Akses PDF Presentasi & Guidelines Pembicara</span>
          </li>
        </ul>
      </div>

      <div class="mt-8">
        <a 
          href="https://wa.me/message/5DNKURZLG6SWD1" 
          target="_blank"
          rel="noopener"
          class="block text-center w-full py-3.5 px-6 rounded-xl bg-slate-800 hover:bg-sky-600 text-white font-bold text-sm transition border border-slate-600 hover:border-sky-500 shadow-md"
        >
          Pilih Tiket Dokter Umum (via WhatsApp) &rarr;
        </a>
      </div>
    </div>

    <!-- Dokter Spesialis Card (Highlighted) -->
    <div class="relative glass-panel-dark p-8 rounded-3xl border-2 border-amber-400 shadow-2xl shadow-amber-500/10 flex flex-col justify-between group">
      <!-- Top Ribbon -->
      <div class="absolute -top-3.5 right-6 px-3 py-1 bg-gradient-to-r from-amber-400 to-amber-500 text-slate-950 text-[10px] font-black uppercase tracking-wider rounded-full shadow-md">
        Spesialis & Konsultan
      </div>

      <div>
        <div class="flex items-center justify-between gap-2 mb-4">
          <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-400/20 text-amber-300 border border-amber-400/30">
            Kategori Dokter Spesialis
          </span>
          <span class="text-xs text-amber-300 font-semibold">Offline Simposium</span>
        </div>

        <h3 class="text-2xl font-black text-white font-heading">Dokter Spesialis</h3>
        <p class="text-xs text-slate-400 mt-1">Sp.PD, Sp.A, Sp.OG, Sp.KJ, Sp.N, Sp.GK, Sp.FM, dan spesialis lainnya</p>

        <div class="mt-6 flex items-baseline gap-2">
          <span class="text-xs text-slate-400 font-semibold">Investasi:</span>
          <span class="text-4xl font-black text-amber-400 font-mono">Rp 400.000</span>
          <span class="text-xs text-slate-400">/ peserta</span>
        </div>

        <ul class="mt-6 space-y-2.5 text-xs text-slate-300">
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-amber-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
            <span>Akses Penuh 2 Hari Simposium (7-8 Nov 2026)</span>
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-amber-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
            <span>Nilai SKP Spesialis Kemenkes RI via Plataran Sehat</span>
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-amber-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
            <span>Seminar Kit Premium & E-Sertifikat SKP</span>
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-amber-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
            <span>Coffee Break & 2 Lunch Simposium Spesialis</span>
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-amber-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
            <span>Prioritas Diskusi Kasus & Interaksi Interaktif</span>
          </li>
        </ul>
      </div>

      <div class="mt-8">
        <a 
          href="https://wa.me/message/5DNKURZLG6SWD1" 
          target="_blank"
          rel="noopener"
          class="block text-center w-full py-3.5 px-6 rounded-xl bg-gradient-to-r from-amber-400 to-amber-500 hover:from-amber-300 hover:to-amber-400 text-slate-950 font-black text-sm shadow-xl transition transform hover:-translate-y-0.5"
        >
          Pilih Tiket Dokter Spesialis (via WhatsApp) &rarr;
        </a>
      </div>
    </div>

  </div>

  <!-- Mandatory Satu Sehat Requirement Banner -->
  <div class="max-w-4xl mx-auto p-5 rounded-2xl bg-amber-500/15 border border-amber-400/40 text-amber-200 flex flex-col sm:flex-row items-center gap-4">
    <div class="w-12 h-12 rounded-xl bg-amber-400/20 border border-amber-400/40 flex items-center justify-center shrink-0 text-amber-400">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
    </div>
    <div class="text-xs sm:text-sm">
      <strong class="text-white block font-bold text-base mb-0.5">SYARAT WAJIB SKP KEMENKES:</strong>
      Peserta harus memiliki akun aktif di <a href="/lms" target="_blank" rel="noopener" class="text-amber-300 underline hover:text-amber-200 font-bold" title="Buka Portal LMS Kemenkes">SATU SEHAT SDMK / PLATARAN SEHAT (<span class="lms-domain-display">ccpg2026kaj.kmki.or.id/lms</span>) &rarr;</a>. Nilai SKP akan diintegrasikan secara resmi sesuai data NIK dan email peserta.
    </div>
  </div>

  <!-- Registration & Official Payment Methods (Direct WhatsApp & QR Code) -->
  <div class="max-w-4xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-8" id="form-reg">
    
    <!-- Left: Official Payment Method Card -->
    <div class="lg:col-span-6 space-y-6">
      <div class="p-6 sm:p-8 rounded-3xl bg-slate-800/90 border-2 border-slate-700 shadow-xl space-y-5">
        <div class="flex items-center gap-2">
          <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-400/20 text-amber-300 border border-amber-400/30">
            Pembayaran Resmi
          </span>
          <span class="text-xs text-emerald-400 font-semibold flex items-center gap-1">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
            Terverifikasi
          </span>
        </div>

        <h4 class="text-xl sm:text-2xl font-black text-white font-heading">
          Metode Pembayaran Resmi
        </h4>

        <!-- Specific requirement statement requested by user -->
        <div class="p-4 rounded-2xl bg-gradient-to-br from-amber-500/15 via-slate-900 to-sky-950 border border-amber-400/40">
          <p class="text-sm font-semibold text-amber-200 leading-relaxed">
            Pembayaran resmi pendaftaran Simposium CCPG 2026 <strong class="text-white">hanya melalui QRIS dan Virtual Account</strong> dari WhatsApp pendaftaran <strong class="text-amber-300 font-mono text-base">0851-9060-5900</strong>.
          </p>
        </div>

        <!-- Payment Channels Supported -->
        <div class="space-y-3">
          <span class="text-xs font-bold text-slate-300 uppercase tracking-wider block">Kanal Pembayaran Didukung:</span>
          <div class="grid grid-cols-2 gap-2.5 text-xs text-slate-200">
            <div class="p-3 rounded-xl bg-slate-900/90 border border-slate-700 flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
              <span class="font-medium">QRIS Seluruh Bank & E-Wallet</span>
            </div>
            <div class="p-3 rounded-xl bg-slate-900/90 border border-slate-700 flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-sky-400"></span>
              <span class="font-medium">Virtual Account Otomatis</span>
            </div>
          </div>
          <p class="text-[11px] text-slate-400 leading-normal">
            Mendukung BCA, Mandiri, BRI, BNI, Permata, CIMB Niaga, GoPay, OVO, ShopeePay, DANA, dan seluruh aplikasi perbankan digital.
          </p>
        </div>

        <!-- Committee Contacts -->
        <div class="pt-4 border-t border-slate-700/80 space-y-2.5 text-xs">
          <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block">Kontak Panitia CCPG 2026:</span>
          <div class="flex items-center justify-between py-1 border-b border-slate-700/40">
            <span class="text-slate-300 font-medium">WhatsApp Hotline Resmi:</span>
            <a href="https://wa.me/message/5DNKURZLG6SWD1" target="_blank" rel="noopener" class="text-emerald-400 font-bold hover:underline font-mono">0851-9060-5900</a>
          </div>
          <div class="flex items-center justify-between py-1 border-b border-slate-700/40">
            <span class="text-slate-300">dr. Hady Syarif, MM:</span>
            <a href="tel:0816792567" class="text-sky-300 font-mono font-medium hover:underline">0816-792-567</a>
          </div>
          <div class="flex items-center justify-between py-1 border-b border-slate-700/40">
            <span class="text-slate-300">Dr. dr. Nanny Djaya, M.Gizi, SpGK:</span>
            <a href="tel:0811180819" class="text-sky-300 font-mono font-medium hover:underline">0811-180-819</a>
          </div>
          <div class="flex items-center justify-between py-1 border-b border-slate-700/40">
            <span class="text-slate-300">Email Panitia:</span>
            <!--email_off--><a href="mailto:nanny.djaja@atmajaya.ac.id" class="text-sky-300 font-mono font-medium hover:underline">nanny.djaja@atmajaya.ac.id</a><!--/email_off-->
          </div>
          <div class="flex items-center justify-between py-1">
            <span class="text-slate-300">dr. Katherine:</span>
            <a href="tel:087888736715" class="text-sky-300 font-mono font-medium hover:underline">0878-8873-6715</a>
          </div>
        </div>

      </div>
    </div>

    <!-- Right: WhatsApp Fast Registration & Barcode -->
    <div class="lg:col-span-6 space-y-6">
      <div class="p-6 sm:p-8 rounded-3xl bg-slate-800/90 border-2 border-amber-400/80 shadow-2xl shadow-amber-500/10 text-center space-y-6 flex flex-col justify-between">
        
        <div>
          <span class="px-3.5 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-500/20 text-emerald-300 border border-emerald-400/30 inline-block mb-3">
            Pendaftaran Cepat
          </span>
          <h3 class="text-2xl font-black text-white font-heading">
            Daftar Langsung via WhatsApp
          </h3>
          <p class="text-xs text-slate-300 mt-1 max-w-sm mx-auto">
            Scan barcode atau klik gambar di bawah ini untuk terhubung langsung ke WhatsApp resmi panitia.
          </p>
        </div>

        <!-- Clickable QR Code -->
        <div class="py-2">
          <a 
            href="https://wa.me/message/5DNKURZLG6SWD1" 
            target="_blank" 
            rel="noopener" 
            class="inline-block group transform hover:scale-105 transition duration-300"
            title="Klik untuk membuka WhatsApp Pendaftaran CCPG 2026"
          >
            <div class="relative p-3 rounded-2xl bg-white shadow-2xl border-2 border-emerald-400 group-hover:border-amber-400 transition">
              <img 
                src="/images/assets_extracted/clean/qr-wa-register.png" 
                alt="Barcode QR WhatsApp Pendaftaran CCPG 2026" 
                class="w-44 h-44 sm:w-48 sm:h-48 mx-auto object-contain"
              />
              <span class="absolute -bottom-3 left-1/2 -translate-x-1/2 whitespace-nowrap bg-emerald-600 text-white text-[10px] font-extrabold px-3 py-0.5 rounded-full shadow-md group-hover:bg-amber-500 group-hover:text-slate-950 transition">
                KLIK ATAU SCAN UNTUK CHAT WA
              </span>
            </div>
          </a>
        </div>

        <!-- Big CTA Button -->
        <div class="space-y-3 pt-2">
          <a 
            href="https://wa.me/message/5DNKURZLG6SWD1" 
            target="_blank" 
            rel="noopener"
            class="w-full inline-flex items-center justify-center gap-3 py-4 px-6 rounded-2xl bg-gradient-to-r from-emerald-500 to-emerald-600 hover:from-emerald-400 hover:to-emerald-500 text-white font-black text-base shadow-xl shadow-emerald-600/30 transition transform hover:-translate-y-0.5"
          >
            <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086s1.011.477 1.184.564.289.13.332.203c.044.072.044.419-.1.824z"/>
            </svg>
            <span>Hubungi WhatsApp Pendaftaran</span>
          </a>

          <p class="text-xs text-slate-400">
            Hotline Resmi: <strong class="text-emerald-400 font-mono">0851-9060-5900</strong>
          </p>
        </div>

        <!-- 3 Quick Steps Guidance -->
        <div class="grid grid-cols-3 gap-2 pt-3 border-t border-slate-700/60 text-left">
          <div class="p-2.5 rounded-xl bg-slate-900/60 border border-slate-800">
            <span class="text-amber-400 font-black text-xs block">1. Chat WA</span>
            <span class="text-[10px] text-slate-400 block mt-0.5">Kirim data Nama & NIK Plataran Sehat</span>
          </div>
          <div class="p-2.5 rounded-xl bg-slate-900/60 border border-slate-800">
            <span class="text-amber-400 font-black text-xs block">2. Bayar QRIS / VA</span>
            <span class="text-[10px] text-slate-400 block mt-0.5">Dapatkan QRIS / VA resmi dari 0851-9060-5900</span>
          </div>
          <div class="p-2.5 rounded-xl bg-slate-900/60 border border-slate-800">
            <span class="text-amber-400 font-black text-xs block">3. E-Tiket Terbit</span>
            <span class="text-[10px] text-slate-400 block mt-0.5">Konfirmasi tiket & SKP resmi Kemenkes</span>
          </div>
        </div>

      </div>
    </div>

  </div>

</div>
