---
import '../styles/global.css';
import DomainSwitcher from '../components/DomainSwitcher.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "KMKI Wilayah Keuskupan Agung Jakarta | Komunitas Medik Katolik Indonesia",
  description = "Portal resmi Komunitas Medik Katolik Indonesia (KMKI) Wilayah Keuskupan Agung Jakarta (KAJ). Wadah perhimpunan profesi dan pelayanan kasih tenaga medis Katolik di DKI Jakarta, Tangerang, dan Bekasi."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/images/assets_extracted/clean/logo-kmki-kaj.png" />
    <link rel="apple-touch-icon" href="/images/assets_extracted/clean/logo-kmki-kaj.png" />

    <!-- OpenGraph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/images/assets_extracted/clean/logo-kmki-kaj.png" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://kaj.kmki.or.id/" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&family=Outfit:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;600;700&display=swap" rel="stylesheet">

    <!-- Subdomain router: Redirect kaj.kmki.or.id to /kaj if at root -->
    <script is:inline>
      if (
        typeof window !== 'undefined' &&
        window.location.hostname.startsWith('kaj') &&
        (window.location.pathname === '/' || window.location.pathname === '')
      ) {
        window.location.replace('/kaj');
      }
    </script>

    <style>
      body {
        font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
      }
      h1, h2, h3, h4, .font-heading {
        font-family: 'Outfit', 'Plus Jakarta Sans', system-ui, sans-serif;
      }
      .font-mono-code {
        font-family: 'JetBrains Mono', monospace;
      }
    </style>
  </head>
  <body class="bg-slate-50 text-slate-800 antialiased selection:bg-sky-500 selection:text-white flex flex-col min-h-screen">
    
    <!-- Top Domain Switcher Bar -->
    <DomainSwitcher currentHighlight="kaj" />

