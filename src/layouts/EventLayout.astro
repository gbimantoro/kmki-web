---
import '../styles/global.css';
import DomainSwitcher from '../components/DomainSwitcher.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'CCPG 2026 - 9th Current Clinical Practice Guidelines | KMKI KAJ & Badiklat FKIK Atma Jaya',
  description = 'Simposium Ilmiah Nasional Offline CCPG 2026. 7-8 November 2026 di Auditorium Stella Maris RS Carolus Jakarta. Akreditasi B Kemenkes RI dengan SKP Plataran Sehat.',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🎓</text></svg>" />

    <!-- OpenGraph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/images/pdf_extracted/page-2.png" />
    <meta property="og:type" content="website" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Outfit:wght@500;600;700;800;900&family=JetBrains+Mono:wght@400;600;700&display=swap" rel="stylesheet">

    <style>
      body {
        font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
      }
      h1, h2, h3, h4, .font-heading {
        font-family: 'Outfit', 'Plus Jakarta Sans', system-ui, sans-serif;
      }
      .font-mono-code {
        font-family: 'JetBrains Mono', monospace;
      }
    </style>
  </head>
  <body class="bg-slate-900 text-slate-100 antialiased selection:bg-amber-400 selection:text-slate-950 flex flex-col min-h-screen">
    
    <!-- Domain Switcher: highlights ccpg2026.kmki.or.id -->
    <DomainSwitcher currentHighlight="ccpg2026" />

    <slot />

    <!-- Floating WhatsApp Action with visible text Daftar Chat -->
    <a 
      href="https://wa.me/message/5DNKURZLG6SWD1" 
      target="_blank" 
      rel="noopener"
      class="fixed bottom-6 right-6 z-50 py-3 px-4 sm:px-5 bg-emerald-500 hover:bg-emerald-600 text-white rounded-full shadow-2xl hover:scale-105 active:scale-95 transition duration-300 flex items-center justify-center gap-2 focus:ring-4 focus:ring-emerald-400 border border-emerald-400/30 shadow-emerald-950/40"
      aria-label="Daftar Chat WhatsApp CCPG 2026"
    >
      <svg class="w-5 h-5 sm:w-6 sm:h-6 fill-current shrink-0" viewBox="0 0 24 24">
        <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086s1.011.477 1.184.564.289.13.332.203c.044.072.044.419-.1.824z"/>
      </svg>
      <span class="text-xs sm:text-sm font-black tracking-wide whitespace-nowrap">
        Daftar Chat
      </span>
    </a>

    <!-- Adaptive Domain Display Script -->
    <script is:inline>
      if (typeof window !== 'undefined') {
        const host = window.location.host;
        if (host.includes('kaj')) {
          document.querySelectorAll('.lms-domain-display').forEach(el => {
            el.textContent = `${host}/lms`;
          });
        }
      }
    </script>
  </body>
</html>
