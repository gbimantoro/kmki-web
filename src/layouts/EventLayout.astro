---
import '../styles/global.css';
import DomainSwitcher from '../components/DomainSwitcher.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'CCPG 2026 - 9th Current Clinical Practice Guidelines | KMKI KAJ & Badiklat FKIK Atma Jaya',
  description = 'Simposium Ilmiah Nasional Offline CCPG 2026. 7-8 November 2026 di Auditorium Stella Maris RS Carolus Jakarta. Akreditasi B Kemenkes RI dengan SKP Plataran Sehat.',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🎓</text></svg>" />

    <!-- OpenGraph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/images/pdf_extracted/page-2.png" />
    <meta property="og:type" content="website" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Outfit:wght@500;600;700;800;900&family=JetBrains+Mono:wght@400;600;700&display=swap" rel="stylesheet">

    <style>
      body {
        font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
      }
      h1, h2, h3, h4, .font-heading {
        font-family: 'Outfit', 'Plus Jakarta Sans', system-ui, sans-serif;
      }
      .font-mono-code {
        font-family: 'JetBrains Mono', monospace;
      }
    </style>
  </head>
  <body class="bg-slate-900 text-slate-100 antialiased selection:bg-amber-400 selection:text-slate-950 flex flex-col min-h-screen">
    
    <!-- Domain Switcher: highlights ccpg2026kaj.kmki.or.id -->
    <DomainSwitcher currentHighlight="ccpg2026" />

    <slot />

    <!-- Floating WhatsApp Action with visible text Chat Daftar Sekarang -->
    <a 
      href="https://wa.me/message/5DNKURZLG6SWD1" 
      target="_blank" 
      rel="noopener"
      class="fixed bottom-6 right-6 z-50 py-3 px-4 sm:px-5 bg-emerald-500 hover:bg-emerald-600 text-white rounded-full shadow-2xl hover:scale-105 active:scale-95 transition duration-300 flex items-center justify-center gap-2 focus:ring-4 focus:ring-emerald-400 border border-emerald-400/30 shadow-emerald-950/40"
      aria-label="Chat Daftar Sekarang WhatsApp CCPG 2026"
    >
      <svg class="w-5 h-5 sm:w-6 sm:h-6 fill-current shrink-0" viewBox="0 0 24 24">
        <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.316 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.818-.981z"/>
      </svg>
      <span class="text-xs sm:text-sm font-black tracking-wide whitespace-nowrap">
        Chat Daftar Sekarang
      </span>
    </a>

    <!-- Adaptive Domain Display Script -->
    <script is:inline>
      if (typeof window !== 'undefined') {
        const host = window.location.host;
        if (host.includes('kaj')) {
          document.querySelectorAll('.lms-domain-display').forEach(el => {
            el.textContent = `${host}/lms`;
          });
        }
      }
    </script>
  </body>
</html>
