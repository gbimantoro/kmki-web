---
import '../styles/global.css';
import MainNavbar from '../components/MainNavbar.astro';
import MainFooter from '../components/MainFooter.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'KMKI - Komunitas Medik Katolik Indonesia',
  description = 'Wadah perhimpunan tenaga medis dan dokter Katolik di Indonesia. Meningkatkan spiritualitas, profesionalisme, dan pelayanan kesehatan berbasis nilai-nilai Kristiani.',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/jpeg" href="/images/logo.jpg" />
    
    <!-- OpenGraph / Social Meta -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/images/header.jpg" />
    <meta property="og:type" content="website" />
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&family=Outfit:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    
    <!-- Subdomain router: Redirect ccpg2026 / ccpg2026kaj to /ccpg2026, or kaj to /kaj if at root -->
    <script is:inline>
      if (
        typeof window !== 'undefined' &&
        (window.location.pathname === '/' || window.location.pathname === '')
      ) {
        if (window.location.hostname.startsWith('ccpg2026') || window.location.hostname.startsWith('ccpg20226')) {
          window.location.replace('/ccpg2026');
        } else if (window.location.hostname.startsWith('kaj')) {
          window.location.replace('/kaj');
        }
      }
    </script>
    
    <style>
      body {
        font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
      }
      h1, h2, h3, h4, .font-heading {
        font-family: 'Outfit', 'Plus Jakarta Sans', system-ui, sans-serif;
      }
    </style>
  </head>
  <body class="bg-slate-50 text-slate-800 antialiased selection:bg-sky-500 selection:text-white flex flex-col min-h-screen">
    
    <MainNavbar />
    
    <main class="flex-grow">
      <slot />
    </main>

    <MainFooter />
  </body>
</html>
