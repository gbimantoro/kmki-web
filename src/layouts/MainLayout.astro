---
import '../styles/global.css';
import MainNavbar from '../components/MainNavbar.astro';
import MainFooter from '../components/MainFooter.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'KMKI - Komunitas Medik Katolik Indonesia',
  description = 'Wadah perhimpunan tenaga medis dan dokter Katolik di Indonesia. Meningkatkan spiritualitas, profesionalisme, dan pelayanan kesehatan berbasis nilai-nilai Kristiani.',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/jpeg" href="/images/logo.jpg" />
    
    <!-- OpenGraph / Social Meta -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/images/header.jpg" />
    <meta property="og:type" content="website" />
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&family=Outfit:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    
    <!-- Subdomain router: Redirect ccpg2026.kmki.or.id to /ccpg2026 if at root -->
    <script is:inline>
      if (typeof window !== 'undefined' && window.location.hostname.startsWith('ccpg2026') && window.location.pathname === '/') {
        window.location.replace('/ccpg2026');
      }
    </script>
    
    <style>
      body {
        font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
      }
      h1, h2, h3, h4, .font-heading {
        font-family: 'Outfit', 'Plus Jakarta Sans', system-ui, sans-serif;
      }
    </style>
  </head>
  <body class="bg-slate-50 text-slate-800 antialiased selection:bg-sky-500 selection:text-white flex flex-col min-h-screen">
    
    <MainNavbar />
    
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Floating WhatsApp Action -->
    <a 
      href="https://wa.me/message/5DNKURZLG6SWD1" 
      target="_blank" 
      rel="noopener"
      class="fixed bottom-6 right-6 z-50 p-3.5 bg-emerald-500 hover:bg-emerald-600 text-white rounded-full shadow-2xl hover:scale-110 transition duration-300 flex items-center justify-center group focus:ring-4 focus:ring-emerald-300"
      aria-label="Chat Daftar CCPG 2026"
    >
      <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
        <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086s1.011.477 1.184.564.289.13.332.203c.044.072.044.419-.1.824z"/>
      </svg>
      <span class="max-w-0 overflow-hidden whitespace-nowrap group-hover:max-w-xs transition-all duration-500 ease-in-out text-xs font-bold pl-0 group-hover:pl-2">
        Chat Daftar CCPG 2026
      </span>
    </a>

    <MainFooter />
  </body>
</html>
